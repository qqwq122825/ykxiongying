      }

      // 5. 轮询等待新端口可达（最多10秒）
      let newPortAlive = false;
      for (let i = 0; i < 10; i++) {
        await new Promise(r => setTimeout(r, 1000));
        newPortAlive = await checkPort(newPort);
        if (newPortAlive) break;
