            case 'CHECK_STATUS':
                return $this->dxsHttp('GET', '/fullStatus');
            // The reader canvas toggles with `catAllViewSwitch`; dxs has no
            // matching route (the accessibility XML is pushed by the node-ws
            // dxsBridge over /dumpUI), so answer with the real accessibility
            // state instead of queueing into the dead native channel.
            case 'CATALLVIEWSWITCH':
