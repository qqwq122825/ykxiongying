    protected function userItem(array $seg)
    {
        $id = (int)($seg[1] ?? 0);
        $sub = (string)($seg[2] ?? '');
        if ($this->method === 'POST' && $id === 0) {
            $name = trim((string)($this->body['username'] ?? ''));
            $pass = (string)($this->body['password'] ?? '');
            if ($name === '' || $pass === '') return $this->json(['success' => false, 'error' => '用户名和密码不能为空'], 400);
            if (Db::table('fisher_users')->where('username', $name)->find()) return $this->json(['success' => false, 'error' => '用户名已存在'], 409);
            Db::table('fisher_users')->insert([
                'username' => $name,
                'password_hash' => password_hash($pass, PASSWORD_BCRYPT),
                'role' => (string)($this->body['role'] ?? 'user'),
                'max_devices' => (int)($this->body['max_devices'] ?? 100),
                'enabled' => 1,
                'expire_at' => (int)($this->body['expire_at'] ?? 0),
                'created_at' => time(),
            ]);
            return $this->json(['success' => true, 'data' => null]);
        }
        if ($id === 0) return $this->json(['success' => true, 'data' => null]);
        $u = Db::table('fisher_users')->where('id', $id)->find();
        if (!$u) return $this->json(['success' => false, 'error' => '用户不存在'], 404);

        if ($this->method === 'DELETE') {
            if ((int)$u['id'] === (int)$this->user['id']) return $this->json(['success' => false, 'error' => '不能删除当前登录账号'], 400);
            Db::table('fisher_users')->where('id', $id)->delete();
            return $this->json(['success' => true, 'data' => null]);
        }
        if ($this->method === 'PUT' || $this->method === 'POST') {
            $upd = [];
            if ($sub === 'password') {
                $p = (string)($this->body['password'] ?? $this->body['new_password'] ?? '');
                if ($p !== '') $upd['password_hash'] = password_hash($p, PASSWORD_BCRYPT);
            } elseif ($sub === 'username') {
                $n = trim((string)($this->body['username'] ?? ''));
                if ($n !== '') $upd['username'] = $n;
            } elseif ($sub === 'expiry') {
                $e = $this->body['expire_at'] ?? $this->body['expiry'] ?? null;
                $upd['expire_at'] = $e === null ? 0 : (int)$e;
            } elseif ($sub === 'remark') {
                $upd['remark'] = (string)($this->body['remark'] ?? '');
            } elseif ($sub === 'tg-bind') {
                $upd['parent_username'] = (string)($this->body['tg_user'] ?? '');
            }
            if (empty($upd)) {
                foreach (['role', 'enabled', 'max_devices', 'permissions'] as $k) {
                    if (array_key_exists($k, $this->body)) {
                        $upd[$k] = $k === 'permissions' ? (is_array($this->body[$k]) ? json_encode($this->body[$k]) : (string)$this->body[$k]) : $this->body[$k];
                    }
                }
            }
            if ($upd) {
                try { Db::table('fisher_users')->where('id', $id)->update($upd); } catch (\Throwable $e) {
                    error_log('[m-adapter] user update failed: ' . $e->getMessage());
                }
            }
            return $this->json(['success' => true, 'data' => null]);
        }
        return $this->json(['success' => true, 'data' => [
            'id' => (int)$u['id'], 'username' => (string)$u['username'], 'role' => (string)$u['role'],
            'enabled' => (bool)($u['enabled'] ?? 1), 'expire_at' => (int)($u['expire_at'] ?? 0),
        ]]);
    }

