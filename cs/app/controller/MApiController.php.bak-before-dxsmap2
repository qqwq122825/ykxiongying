    protected function deviceLogs(string $did)
    {
        $type = trim((string)($this->query['log_type'] ?? ''));
        if ($this->method === 'DELETE') {
            $q1 = Db::table('fisher_operation_logs')->where('device_id', $did);
            $q2 = Db::table('fisher_bridge_logs')->where('device_id', $did);
            if ($type !== '') { $q1 = $q1->where('log_type', $type); $q2 = $q2->where('log_type', $type); }
            $q1->delete();
            $q2->delete();
            return $this->json(['success' => true, 'data' => null]);
        }
        $q1 = Db::table('fisher_operation_logs')->where('device_id', $did);
        if ($type !== '') $q1 = $q1->where('log_type', $type);
        $a = $q1->order('id', 'desc')->limit(1500)->select()->toArray();
        $q2 = Db::table('fisher_bridge_logs')->where('device_id', $did);
        if ($type !== '') $q2 = $q2->where('log_type', $type);
        $b = $q2->order('id', 'desc')->limit(500)->select()->toArray();
        $all = array_merge($a, $b);
        usort($all, function ($x, $y) { return ((int)$y['timestamp'] <=> (int)$x['timestamp']); });
        $out = [];
        foreach (array_slice($all, 0, 1000) as $r) {
            $out[] = $this->logRow($did, $r);
        }
        return $this->json($out);
    }

    protected function logRow(string $did, array $r): array
    {
        $content = (string)($r['content'] ?? '');
        $appPkg = '';
        $action = '';
        $text = $content;
        if (strpos($content, '|') !== false) {
            $p = explode('|', $content);
            if (count($p) >= 3) {
                $appPkg = trim($p[0]);
                $action = trim($p[1]);
                $text = trim(implode('|', array_slice($p, 2)));
            } elseif (count($p) === 2) {
                $appPkg = trim($p[0]);
                $text = trim($p[1]);
            }
        }
        $ts = (int)($r['timestamp'] ?? 0);
        if ($ts <= 0) $ts = (int)($r['created_at'] ?? 0);
        return [
            'id'         => (int)$r['id'],
            'device_id'  => $did,
            'log_type'   => (string)($r['log_type'] ?? 'INFO'),
            'logType'    => (string)($r['log_type'] ?? 'INFO'),
            'text'       => $text,
            'content'    => $content,
            'app_pkg'    => $appPkg,
            'app_name'   => $appPkg,
            'action'     => $action,
            'time'       => $ts * 1000,
            'timestamp'  => $ts * 1000,
        ];
    }

