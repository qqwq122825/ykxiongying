    // ================= security =================
    protected function security(array $seg)
    {
        $what = (string)($seg[1] ?? '');
        if ($this->method === 'DELETE') {
            if ($what === 'logs') { Db::table('fisher_operation_logs')->delete(true); Db::table('fisher_bridge_logs')->delete(true); }
            if ($what === 'login-attempts') Db::table('fisher_login_logs')->delete(true);
            if ($what === 'ip-whitelist') $this->settingPut('ip_whitelist', '[]');
            return $this->json(['success' => true, 'data' => null]);
        }
        $page = max(1, (int)($this->query['page'] ?? 1));
        $size = (int)($this->query['page_size'] ?? $this->query['pageSize'] ?? 50);
        if ($size < 1) $size = 50;
        if ($size > 500) $size = 500;

        if ($what === 'login-attempts') {
            $q = Db::table('fisher_login_logs');
            $status = trim((string)($this->query['status'] ?? 'all'));
            if ($status === 'success') $q = $q->where('success', 1);
            if ($status === 'failed' || $status === 'fail') $q = $q->where('success', 0);
            $total = (int)$q->count();
            $rows = $q->order('id', 'desc')->page($page, $size)->select()->toArray();
            $items = [];
            foreach ($rows as $r) {
                $items[] = [
                    'id' => (int)$r['id'],
                    'username' => (string)($r['username'] ?? ''),
                    'ip' => (string)($r['ip'] ?? ''),
                    'user_agent' => (string)($r['user_agent'] ?? ''),
                    'status' => ((int)($r['success'] ?? 0) === 1) ? 'success' : 'failed',
                    'success' => (bool)($r['success'] ?? 0),
                    'created_at' => $this->ts($r['created_at'] ?? 0),
                    'time' => (int)($r['created_at'] ?? 0) * 1000,
                ];
            }
            return $this->json(['items' => $items, 'list' => $items, 'total' => $total, 'page' => $page, 'page_size' => $size]);
        }
        if ($what === 'ip-whitelist') {
            if ($this->method === 'POST' || $this->method === 'PUT') {
                $v = $this->body['list'] ?? $this->body['items'] ?? $this->body;
                $this->settingPut('ip_whitelist', json_encode($v, JSON_UNESCAPED_UNICODE));
                return $this->json(['success' => true, 'data' => null]);
            }
            $v = Db::table('fisher_settings')->where('key', 'ip_whitelist')->value('value');
            $d = json_decode((string)$v, true);
            return $this->json(is_array($d) ? $d : []);
        }
        if ($this->method === 'POST' || $this->method === 'PUT') {
            return $this->json(['success' => true, 'data' => null]);
        }
        $q = Db::table('fisher_operation_logs');
        $level = trim((string)($this->query['level'] ?? ''));
        if ($level !== '' && $level !== 'all') $q = $q->where('log_type', $level);
        $total = (int)$q->count();
        $rows = $q->order('id', 'desc')->page($page, $size)->select()->toArray();
        $items = [];
        foreach ($rows as $r) {
            $ts = (int)($r['timestamp'] ?? 0);
            $items[] = [
                'id' => (int)$r['id'],
                'device_id' => (string)($r['device_id'] ?? ''),
                'log_type' => (string)($r['log_type'] ?? 'info'),
                'level' => (string)($r['log_type'] ?? 'info'),
