    {
        $base = strtoupper((string)($this->query['base'] ?? 'USD'));
        $static = [
            'USD' => 1.0, 'CNY' => 7.24, 'EUR' => 0.92, 'GBP' => 0.79, 'JPY' => 149.6,
            'HKD' => 7.82, 'TWD' => 32.1, 'KRW' => 1338.0, 'SGD' => 1.34, 'AUD' => 1.52,
            'CAD' => 1.36, 'CHF' => 0.89, 'RUB' => 92.5, 'INR' => 83.2, 'THB' => 35.6,
            'MYR' => 4.68, 'IDR' => 15680.0, 'PHP' => 56.3, 'VND' => 24600.0, 'BRL' => 5.02,
            'MXN' => 17.1, 'TRY' => 32.2, 'ZAR' => 18.7, 'AED' => 3.67, 'SAR' => 3.75,
