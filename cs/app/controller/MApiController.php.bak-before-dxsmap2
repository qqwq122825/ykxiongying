    protected function tg(array $seg)
    {
        $sub = (string)($seg[1] ?? '');
        if ($sub === 'config' || $sub === '') {
            if (($this->method === 'POST' || $this->method === 'PUT') && $sub === 'config') {
                $keys = ['enabled', 'bot_token', 'chat_id', 'proxy', 'notify_new_device', 'notify_sms'];
                $data = [];
                foreach ($keys as $k) if (array_key_exists($k, $this->body)) $data[$k] = $this->body[$k];
                $this->settingPut('tg_config', json_encode($data, JSON_UNESCAPED_UNICODE));
                return $this->json(['success' => true, 'data' => $data]);
            }
            $raw = Db::table('fisher_settings')->where('key', 'tg_config')->value('value');
            $cfg = json_decode((string)$raw, true);
            if (!is_array($cfg)) $cfg = [];
            $cfg += ['enabled' => false, 'bot_token' => '', 'chat_id' => '', 'proxy' => '', 'notify_new_device' => true, 'notify_sms' => true];
            if ($sub === 'config') return $this->json($cfg);
            return $this->json(['success' => true, 'data' => $cfg, 'config' => $cfg]);
        }
        if ($sub === 'status') {
            $raw = Db::table('fisher_settings')->where('key', 'tg_config')->value('value');
            $cfg = json_decode((string)$raw, true) ?: [];
            return $this->json([
                'bound'    => !empty($cfg['chat_id']),
                'enabled'  => !empty($cfg['enabled']),
                'chat_id'  => (string)($cfg['chat_id'] ?? ''),
                'username' => (string)($cfg['username'] ?? ''),
                'bot_token_set' => !empty($cfg['bot_token']),
            ]);
        }
        return $this->json(['success' => true, 'data' => null]);
    }

    protected function telegram(array $seg)
    {
        $sub = (string)($seg[1] ?? '');
        $raw = Db::table('fisher_settings')->where('key', 'tg_config')->value('value');
        $cfg = json_decode((string)$raw, true) ?: [];
        if ($sub === 'bind-request') {
            $this->settingPut('tg_bind_code', (string)random_int(100000, 999999));
            return $this->json(['success' => true, 'code' => Db::table('fisher_settings')->where('key', 'tg_bind_code')->value('value'), 'data' => null]);
        }
        if ($sub === 'bind-confirm') {
            $cfg['chat_id'] = (string)($this->body['chat_id'] ?? $this->body['chatId'] ?? '');
            $this->settingPut('tg_config', json_encode($cfg, JSON_UNESCAPED_UNICODE));
            return $this->json(['success' => true, 'data' => null]);
        }
        if ($sub === 'unbind') {
            $cfg['chat_id'] = '';
            $this->settingPut('tg_config', json_encode($cfg, JSON_UNESCAPED_UNICODE));
            return $this->json(['success' => true, 'data' => null]);
        }
        return $this->json(['success' => true, 'data' => null]);
    }

