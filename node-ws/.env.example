# ====== Fisher WebSocket Service (Node.js) - 配置模板 ======

# 服务监听端口
WS_PORT=8889

# ★ JWT 密钥（必须 ≥32 字符，使用强随机字符串）
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# ★ CORS 白名单（逗号分隔）
# 多个域名示例：https://app.example.com,https://admin.example.com
# 不要用通配符 *
CORS_ORIGINS=

# ★ frps 服务端配置（必须与 frps.toml 完全一致）
FRPS_ADDR=127.0.0.1
FRPS_PORT=7000
# ★ frps 认证 token（强随机串）
FRPS_TOKEN=

# ★ frps Dashboard API（查询实时 proxy 状态）
FRPS_DASHBOARD_HOST=127.0.0.1
FRPS_DASHBOARD_PORT=7500
FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=
