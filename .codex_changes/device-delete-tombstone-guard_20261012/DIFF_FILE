+async function isDeviceDeleted(deviceId) {
+  if (!deviceId) return false;
+  try {
+    const [rows] = await getPool().query(
+      'SELECT value FROM fisher_settings WHERE `key` = ? LIMIT 1',
+      [`device_deleted:${deviceId}`]
