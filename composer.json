{
    "name": "fisher/v6-remote-control",
    "description": "Fisher V6 - Android Remote Control Platform",
    "type": "project",
    "license": "Proprietary",
    "require": {
        "php": ">=8.0.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-fileinfo": "*",
        "ext-zip": "*",
        "topthink/framework": "^6.1 || ^8.0",
        "topthink/think-orm": "^3.0 || ^4.0",
        "topthink/think-validate": "^2.0 || ^3.0",
        "topthink/think-helper": "^3.1",
        "topthink/think-filesystem": "^1.0 || ^2.0",
        "topthink/think-trace": "^1.0 || ^2.0",
        "topthink/think-multi-app": "^1.0 || ^2.0",
        "topthink/think-view": "^1.0 || ^2.0",
        "league/flysystem": "^1.1",
        "league/flysystem-cached-adapter": "^1.1",
        "league/mime-type-detection": "^1.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "psr/http-message": "^1.0 || ^2.0",
        "symfony/var-dumper": "^5.4 || ^6.0 || ^7.0",
        "symfony/polyfill-mbstring": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": []
    }
}
